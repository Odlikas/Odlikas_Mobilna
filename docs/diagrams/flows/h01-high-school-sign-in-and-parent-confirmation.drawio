<mxfile host="Odlikas-diagrams" pages="1"><diagram id="p-h01" name="H01 High-school sign-in and parent confirmation"><mxGraphModel adaptiveColors="auto"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="H01 · High-school sign-in and parent confirmation" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=18;fontColor=#222222;fontFamily=Helvetica;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="2744" height="30" as="geometry"/></mxCell><mxCell id="summary" value="Srednja mode is picked from the e-Dnevnik grade. AAI sign-in. Under 16, a parent confirms on a web page." style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=12;fontColor=#222222;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="0" y="30" width="2744" height="34" as="geometry"/></mxCell><mxCell id="lane0" value="High-school app" style="swimlane;horizontal=0;startSize=34;fillColor=#EEF6EA;swimlaneFillColor=#EEF6EA;strokeColor=#BBBBBB;fontStyle=1;fontSize=13;html=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="0" y="70" width="2744" height="274" as="geometry"/></mxCell><mxCell id="lane1" value="Server" style="swimlane;horizontal=0;startSize=34;fillColor=#F1F1F1;swimlaneFillColor=#F1F1F1;strokeColor=#BBBBBB;fontStyle=1;fontSize=13;html=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="0" y="344" width="2744" height="114" as="geometry"/></mxCell><mxCell id="lane2" value="External" style="swimlane;horizontal=0;startSize=34;fillColor=#FFF8E8;swimlaneFillColor=#FFF8E8;strokeColor=#BBBBBB;fontStyle=1;fontSize=13;html=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="0" y="458" width="2744" height="119" as="geometry"/></mxCell><mxCell id="lane3" value="Web" style="swimlane;horizontal=0;startSize=34;fillColor=#F7F7F7;swimlaneFillColor=#F7F7F7;strokeColor=#BBBBBB;fontStyle=1;fontSize=13;html=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="0" y="577" width="2744" height