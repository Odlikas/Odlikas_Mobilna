<mxfile host="Odlikas-diagrams" pages="1"><diagram id="p-k16" name="K16 Streak (niz) and leaderboard (ljestvica)"><mxGraphModel adaptiveColors="auto"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="K16 · Streak (niz) and leaderboard (ljestvica)" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=18;fontColor=#222222;fontFamily=Helvetica;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1672" height="30" as="geometry"/></mxCell><mxCell id="summary" value="Streak +1 day after the first counted task. Rewards: day 3 Iskra badge, day 7 +1 h weekend, day 14 Plamen badge, day 30 gold medal. Joining the leaderboard needs parent approval." style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=12;fontColor=#222222;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="0" y="30" width="1672" height="34" as="geometry"/></mxCell><mxCell id="lane0" value="Kid app" style="swimlane;horizontal=0;startSize=34;fillColor=#EAF5FB;swimlaneFillColor=#EAF5FB;strokeColor=#BBBBBB;fontStyle=1;fontSize=13;html=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="0" y="70" width="1672" height="347" as="geometry"/></mxCell><mxCell id="lane1" value="Server" style="swimlane;horizontal=0;startSize=34;fillColor=#F1F1F1;swimlaneFillColor=#F1F1F1;strokeColor=#BBBBBB;fontStyle=1;fontSize=13;html=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="0" y="417" width="1672" height="470" as="geometry"/></mxCell><mxCell id="lane2" value="Parent app" style="swimlane;horizontal=0;startSize=34;fillColor=#FDF3E7;swimlaneFillColor=#FDF3E7;strokeColor=#BBBBBB;fontStyle=1;fontSize=13;html=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="0" y="887" width="1672" height="144" as="geometry"/></mxCell><mxCell id="s" value="First counted task of the day" style="ellipse;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="74" y="117" width="152" height="58" as="geometry"/></mxCell><mxCell id="inc" value="streak + 1" style="shape=cylinder3;boundedLbl=1;size=8;fillColor=#d5e8d4;strokeColor=#82b366;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="332" y="481" width="172" height="50" as="geometry"/></mxCell><mxCell id="mile" value="Day 3 / 7 / 14 / 30?" style="rhombus;fillColor=#fff2cc;strokeColor=#d6b656;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="600" y="464" width="172" height="84" as="geometry"/></mxCell><mxCell id="rw" value="Reward: Iskra / +1 h weekend /&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;Plamen / zlatna medalja&lt;/font&gt;" style="shape=cylinder3;boundedLbl=1;size=8;fillColor=#d5e8d4;strokeColor=#82b366;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="868" y="471" width="172" height="70" as="geometry"/></mxCell><mxCell id="show" value="Niz nagrada" style="rounded=1;arcSize=12;fillColor=#ffffff;strokeColor=#1794D2;strokeWidth=2;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1136" y="121" width="172" height="50" as="geometry"/></mxCell><mxCell id="plus" value="Niz +1 dan" style="ellipse;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1414" y="120" width="152" height="52" as="geometry"/></mxCell><mxCell id="s2" value="Midnight: no counted task yesterday" style="ellipse;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="74" y="477" width="152" height="58" as="geometry"/></mxCell><mxCell id="prot" value="Plan was paused, or&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;streak protection left?&lt;/font&gt;" style="rhombus;fillColor=#fff2cc;strokeColor=#d6b656;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="332" y="593" width="172" height="118" as="geometry"/></mxCell><mxCell id="keep" value="Streak kept" style="ellipse;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="610" y="626" width="152" height="52" as="geometry"/></mxCell><mxCell id="reset" value="Streak back to 0" style="ellipse;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="610" y="772" width="152" height="52" as="geometry"/></mxCell><mxCell id="s3" value="Ljestvica → PRIDRUŽI SE" style="ellipse;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="74" y="222" width="152" height="52" as="geometry"/></mxCell><mxCell id="req" value="Join request → push to parent" style="shape=cylinder3;boundedLbl=1;size=8;fillColor=#d5e8d4;strokeColor=#82b366;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="332" y="771" width="172" height="54" as="geometry"/></mxCell><mxCell id="pend" value="Čeka odobrenje" style="rounded=1;arcSize=12;fillColor=#ffffff;strokeColor=#1794D2;strokeWidth=2;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="600" y="121" width="172" height="50" as="geometry"/></mxCell><mxCell id="pd" value="Odobri ljestvicu?" style="rhombus;fillColor=#fff2cc;strokeColor=#d6b656;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="868" y="917" width="172" height="84" as="geometry"/></mxCell><mxCell id="join" value="On the leaderboard&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;(points; +10 for a self-fix)&lt;/font&gt;" style="ellipse;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1146" y="211" width="152" height="74" as="geometry"/></mxCell><mxCell id="no" value="Stays off (nisi pridružen)" style="ellipse;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1146" y="321" width="152" height="58" as="geometry"/></mxCell><mxCell id="e0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;endFill=1;strokeColor=#555555;labelBackgroundColor=default;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="s" target="inc"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;endFill=1;strokeColor=#555555;labelBackgroundColor=default;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="inc" target="mile"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e2" value="Yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;endFill=1;strokeColor=#555555;labelBackgroundColor=default;fontColor=#2D7600;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="mile" target="rw"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e3" value="No" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;endFill=1;strokeColor=#555555;labelBackgroundColor=default;fontColor=#B20000;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="mile" target="plus"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="786" y="506"/><mxPoint x="786" y="78"/><mxPoint x="1390" y="78"/><mxPoint x="1390" y="146"/></Array></mxGeometry></mxCell><mxCell id="e4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;endFill=1;strokeColor=#555555;labelBackgroundColor=default;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="rw" target="show"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;endFill=1;strokeColor=#555555;labelBackgroundColor=default;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="show" target="plus"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;endFill=1;strokeColor=#555555;labelBackgroundColor=default;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="s2" target="prot"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e7" value="Yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;endFill=1;strokeColor=#555555;labelBackgroundColor=default;fontColor=#2D7600;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="prot" target="keep"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e8" value="No" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;endFill=1;strokeColor=#555555;labelBackgroundColor=default;fontColor=#B20000;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="prot" target="reset"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;endFill=1;strokeColor=#555555;labelBackgroundColor=default;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="s3" target="req"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;endFill=1;strokeColor=#555555;labelBackgroundColor=default;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="