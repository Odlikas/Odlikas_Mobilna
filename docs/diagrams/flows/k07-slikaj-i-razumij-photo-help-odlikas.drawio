<mxfile host="Odlikas-diagrams" pages="1"><diagram id="p-k07" name="K07 Slikaj i razumij (photo help, Odlikaš+)"><mxGraphModel adaptiveColors="auto"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="K07 · Slikaj i razumij (photo help, Odlikaš+)" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=18;fontColor=#222222;fontFamily=Helvetica;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="5424" height="30" as="geometry"/></mxCell><mxCell id="summary" value="Cascade: on-device OCR → shared solution cache → solve in code → small model → bigger model once. Steps shown one at a time. Never unlocks games." style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=12;fontColor=#222222;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="0" y="30" width="5424" height="34" as="geometry"/></mxCell><mxCell id="lane0" value="Kid app" style="swimlane;horizontal=0;startSize=34;fillColor=#EAF5FB;swimlaneFillColor=#EAF5FB;strokeColor=#BBBBBB;fontStyle=1;fontSize=13;html=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="0" y="70" width="5424" height="377" as="geometry"/></mxCell><mxCell id="lane1" value="Server" style="swimlane;horizontal=0;startSize=34;fillColor=#F1F1F1;swimlaneFillColor=#F1F1F1;strokeColor=#BBBBBB;fontStyle=1;fontSize=13;html=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="0" y="447" width="5424" height="274" as="geometry"/></mxCell><mxCell id="lane2" value="External" style="swimlane;horizontal=0;startSize=34;fillColor=#FFF8E8;swimlaneFillColor=#FFF8E8;strokeColor=#BBBBBB;fontStyle=1;fontSize=13;html=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="0" y="721" width="5424" height="123" as="geometry"/></mxCell><mxCell id="s" value="Camera: Učenje setup / focus,&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;AI bar, subject page&lt;/font&gt;" style="ellipse;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;whiteSpace=wrap;html=