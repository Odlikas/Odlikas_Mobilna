nd"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="note0" value="Over the daily AI budget (B02) the cascade stops after the cache and code steps. 'Ovo nije točno' on a step → K13." style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;fontColor=#555555;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="0" y="860" width="5424" height="20" as="geometry"/></mxCell><mxCell id="note1" value="Legend: green = start/success · blue = step · white = screen · yellow = decision · orange = external / waiting · purple = paid AI or Odlikaš+ · red = error / stop · dashed line = loop back" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;fontColor=#555555;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="0" y="882" width="5424" height="20" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>