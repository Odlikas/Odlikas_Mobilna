" edge="1" parent="1" source="own" target="need"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e11" value="Yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;endFill=1;strokeColor=#555555;labelBackgroundColor=default;fontColor=#2D7600;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="need" target="plan"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e12" value="No" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;endFill=1;strokeColor=#555555;labelBackgroundColor=default;fontColor=#B20000;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="need" target="save"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1331" y="280"/><mxPoint x="1331" y="653"/><mxPoint x="1631" y="653"/><mxPoint x="1631" y="728"/></Array></mxGeometry></mxCell><mxCell id="e13" value="Yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;endFill=1;strokeColor=#555555;labelBackgroundColor=default;fontColor=#2D7600;exitX=0.5;exitY=1;entryX=0;entryY=0.5;" edge="1" parent="1" source="plan" target="save"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e14" value="No" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;endFill=1;strokeColor=#555555;labelBackgroundColor=default;fontColor=#B20000;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="plan" target="lock"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e15" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;endFill=1;strokeColor=#555555;labelBackgroundColor=default;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="wk" target="save"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1072" y="538"/><mxPoint x="1072" y="662"/><mxPoint x="1658" y="662"/><mxPoint x="1658" y="728"/></Array></mxGeometry></mxCell><mxCell id="e16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;endFill=1;strokeColor=#555555;labelBackgroundColor=default;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="save" target="rt"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="note0" value="Weekends are paused unless 'Zadaci i vikendom' is on; school holidays are always paused. Free: 3 quizzes per week (B03)." style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;fontColor=#555555;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="0" y="927" width="2208" height="20" as="geometry"/></mxCell><mxCell id="note1" value="Legend: green = start/success · blue = step · white = screen · yellow = decision · orange = external / waiting · purple = paid AI or Odlikaš+ · red = error / stop · dashed line = loop back" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;fontColor=#555555;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="0" y="949" width="2208" height="20" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>