<mxfile host="Odlikas-diagrams" pages="1"><diagram id="p-p04" name="P04 Autopilot tasks: what the parent sees and can change"><mxGraphModel adaptiveColors="auto"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="P04 · Autopilot tasks: what the parent sees and can change" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=18;fontColor=#222222;fontFamily=Helvetica;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="2208" height="30" as="geometry"/></mxCell><mxCell id="summary" value="The daily plan (Učenje + Kviz + Kartice) is built automatically (K02). The parent is informed, never asked to approve, and can still adjust it." style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=12;fontColor=#222222;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="0" y="30" width="2208" height="34" as="geometry"/></mxCell><mxCell id="lane0" value="Parent app" style="swimlane;horizontal=0;startSize=34;fillColor=#FDF3E7;swimlaneFillColor=#FDF3E7;strokeColor=#BBBBBB;fontStyle=1;fontSize=13;html=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="0" y="70" width="2208" height="548" as="geometry"/></mxCell><mxCell id="lane1" value="Server" style="swimlane;horizontal=0;startSize=34;fillColor=#F1F1F1;swimlaneFillColor=#F1F1F1;strokeColor=#BBBBBB;fontStyle=1;fontSize=13;html=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="0" y="618" width="2208" height="175" as="geometry"/></mxCell><mxCell id="lane2" value="Kid app" style="swimlane;horizontal=0;startSize=34;fillColor=#EAF5FB;swimlaneFillColor=#EAF5FB;strokeColor=#BBBBBB;fontStyle=1;fontSize=13;html=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="0" y="793" width="2208" height="118" as="geometry"/></mxCell><mxCell id="s" value="Parent: Zadaci tab" style="ellipse;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="74" y="124" width="152" height="52" as="geometry"/></mxCell><mxCell id="list" value="Today's plan per child&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;(autopilot)&lt;/font&gt;" style="rounded=1;arcSize=12;fillColor=#ffffff;strokeColor=#1794D2;strokeWidth=2;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="332" y="124" width="172" height="54" as="geometry"/></mxCell><mxCell id="act" value="Action?" style="rhombus;fillColor=#fff2cc;strokeColor=#d6b656;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="600" y="108" width="172" height="84" as="geometry"/></mxCell><mxCell id="lp" value="Long-press a task:&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;Ukloni / Zamijeni&lt;/font&gt;" style="rounded=1;arcSize=12;fillColor=#ffffff;strokeColor=#1794D2;strokeWidth=2;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="868" y="124" width="172" height="54" as="geometry"/></mxCell><mxCell id="topic" value="Tema za Luku&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;(curriculum list)&lt;/font&gt;" style="rounded=1;arcSize=12;fillColor=#ffffff;strokeColor=#1794D2;strokeWidth=2;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="868" y="252" width="172" height="54" as="geometry"/></mxCell><mxCell id="scan" value="Slikaj knjigu: on-device scanner&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;→ AI 10 questions + 5 cards&lt;/font&gt;" style="rounded=1;arcSize=12;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1136" y="108" width="172" height="86" as="geometry"/></mxCell><mxCell id="own" value="+ Vlastiti zadatak&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;(kviz / kartice / tema)&lt;/font&gt;" style="rounded=1;arcSize=12;fillColor=#ffffff;strokeColor=#1794D2;strokeWidth=2;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="868" y="382" width="172" height="54" as="geometry"/></mxCell><mxCell id="need" value="Needs Odlikaš+?&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;(kartice, 4th quiz this week)&lt;/font&gt;" style="rhombus;fillColor=#fff2cc;strokeColor=#d6b656;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1136" y="229" width="172" height="101" as="geometry"/></mxCell><mxCell id="plan" value="Odlikaš+ or trial?" style="rhombus;fillColor=#fff2cc;strokeColor=#d6b656;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1404" y="108" width="172" height="84" as="geometry"/></mxCell><mxCell id="lock" value="→ P10 limit kvizova /&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;Odlikaš+ ponuda&lt;/font&gt;" style="ellipse;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1682" y="122" width="152" height="58" as="geometry"/></mxCell><mxCell id="wk" value="Zadaci i vikendom toggle,&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;slobodan dan, Otključaj ručno&lt;/font&gt;" style="rounded=1;arcSize=12;fillColor=#ffffff;strokeColor=#1794D2;strokeWidth=2;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="868" y="494" width="172" height="86" as="geometry"/></mxCell><mxCell id="save" value="Plan overrides / topic /&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;child_settings + audit_log&lt;/font&gt;" style="shape=cylinder3;boundedLbl=1;size=8;fillColor=#d5e8d4;strokeColor=#82b366;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1672" y="693" width="172" height="70" as="geometry"/></mxCell><mxCell id="rt" value="Kid plan updates (realtime)" style="ellipse;fillC