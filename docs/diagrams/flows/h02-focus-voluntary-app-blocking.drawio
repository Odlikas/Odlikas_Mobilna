<mxfile host="Odlikas-diagrams" pages="1"><diagram id="p-h02" name="H02 Focus (voluntary app blocking)"><mxGraphModel adaptiveColors="auto"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="H02 · Focus (voluntary app blocking)" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=18;fontColor=#222222;fontFamily=Helvetica;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="2208" height="30" as="geometry"/></mxCell><mxCell id="summary" value="High-schoolers choose to focus; it needs the app-block permission. Blocked apps show a screen during focus." style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=12;fontColor=#222222;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="0" y="30" width="2208" height="34" as="geometry"/></mxCell><mxCell id="lane0" value="High-school app" style="swimlane;horizontal=0;startSize=34;fillColor=#EEF6EA;swimlaneFillColor=#EEF6EA;strokeColor=#BBBBBB;fontStyle=1;fontSize=13;html=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="0" y="70" width="2208" height="395" as="geometry"/></mxCell><mxCell id="s" value="Fokus postavi (e.g. 45 min)" style="ellipse;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="74" y="122" width="152" height="58" as="geometry"/></mxCell><mxCell id="perm" value="App-block permission?" style="rhombus;fillColor=#fff2cc;strokeColor=#d6b656;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="332" y="109" width="172" height="84" as="geometry"/></mxCell><mxCell id="set" value="Fokus dopuštenje → Otvori postavke" style="rounded=1;arcSize=12;fillColor=#ffffff;strokeColor=#1794D2;strokeWidth=2;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="600" y="124" width="172" height="54" as="geometry"/></mxCell><mxCell id="run" value="Fokus u tijeku" sty