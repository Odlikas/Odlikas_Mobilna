<mxfile host="Odlikas-diagrams" pages="1"><diagram id="p-p13" name="P13 Dogovor (agreement) and trial start"><mxGraphModel adaptiveColors="auto"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="P13 · Dogovor (agreement) and trial start" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=18;fontColor=#222222;fontFamily=Helvetica;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="3548" height="30" as="geometry"/></mxCell><mxCell id="summary" value="The parent proposes daily minutes, the kid accepts or proposes a change, the parent accepts. The first signed dogovor starts the 14-day Odlikaš+ trial (server entitlement, no card)." style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=12;fontColor=#222222;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="0" y="30" width="3548" height="34" as="geometry"/></mxCell><mxCell id="lane0" value="Parent app" style="swimlane;horizontal=0;startSize=34;fillColor=#FDF3E7;swimlaneFillColor=#FDF3E7;strokeColor=#BBBBBB;fontStyle=1;fontSize=13;html=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="0" y="70" width="3548" height="162" as="geometry"/></mxCell><mxCell id="lane1" value="Server" style="swimlane;horizontal=0;startSize=34;fillColor=#F1F1F1;swimlaneFillColor=#F1F1F1;strokeColor=#BBBBBB;fontStyle=1;fontSize=13;html=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="0" y="232" width="3548" height="187" as="geometry"/></mxCell><mxCell id="lane2" value="Kid app" style="swimlane;horizontal=0;startSize=34;fillColor=#EAF5FB;swimlaneFillColor=#EAF5FB;strokeColor=#BBBBBB;fontStyle=1;fontSize=13;html=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="0" y="419" width="3548" height="144" as="geometry"/></mxCell><mxCell id="s" value="Dogovor s djetetom&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;(onboarding or Postavke)&lt;/font&gt;" style="ellipse;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="74" y="122" width="152" height="58" as="geometry"/></mxCell><mxCell id="prop" value="Propose daily minutes (e.g. 45)&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;→ Dogovor poslan&lt;/font&gt;" style="rounded=1;arcSize=12;fillColor=#ffffff;strokeColor=#1794D2;strokeWidth=2;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="332" y="116" width="172" height="70" as="geometry"/></mxCell><mxCell id="send" value="agreements: proposed&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;push to kid&lt;/font&gt;" style="shape=cylinder3;boundedLbl=1;size=8;fillColor=#d5e8d4;strokeColor=#82b366;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="600" y="303" width="172" height="54" as="geometry"/></mxCell><mxCell id="kv" value="Dogovor prijedlog" style="rounded=1;arcSize=12;fillColor=#ffffff;strokeColor=#1794D2;strokeWidth=2;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="868" y="466" width="172" height="50" as="geometry"/></mxCell><mxCell id="kd" value="Kid?" style="rhombus;fillColor=#fff2cc;strokeColor=#d6b656;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1136" y="449" width="172" height="84" as="geometry"/></mxCell><mxCell id="kch" value="Predloži promjenu&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;(other minutes + message)&lt;/font&gt;" style="rounded=1;arcSize=12;fillColor=#ffffff;strokeColor=#1794D2;strokeWidth=2;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1404" y="456" width="172" height="70" as="geometry"/></mxCell><mxCell id="ksend" value="agreements: counter-proposal&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;push to parent&lt;/font&gt;" style="shape=cylinder3;boundedLbl=1;size=8;fillColor=#d5e8d4;strokeColor=#82b366;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1672" y="295" width="172" height="70" as="geometry"/></mxCell><mxCell id="pv" value="Lukin prijedlog" style="rounded=1;arcSize=12;fillColor=#ffffff;strokeColor=#1794D2;strokeWidth=2;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1940" y="126" width="172" height="50" as="geometry"/></mxCell><mxCell id="pd" value="Parent?" style="rhombus;fillColor=#fff2cc;strokeColor=#d6b656;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="2208" y="109" width="172" height="84" as="geometry"/></mxCell><mxCell id="sign" value="agreements: signed&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;(minutes, signed_at)&lt;/font&gt;" style="shape=cylinder3;boundedLbl=1;size=8;fillColor=#d5e8d4;strokeColor=#82b366;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="2476" y="303" width="172" height="54" as="geometry"/></mxCell><mxCell id="trial" value="First signed dogovor&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;and no trial yet?&lt;/font&gt;" style="rhombus;fillColor=#fff2cc;strokeColor=#d6b656;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="2744" y="271" width="172" height="118" as="geometry"/></mxCell><mxCell id="tstart" value="Trial entitlement, 14 days&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;(Google Play untouched)&lt;/font&gt;" style="shape=cylinder3;boundedLbl=1;size=8;fillColor=#d5e8d4;strokeColor=#82b366;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="3012" y="295" width="172" height="70" as="geometry"/></mxCell><mxCell id="apps" value="Dogovor potpisan →&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;Odaberi aplikacije&lt;/font&gt;" style="ellipse;fillColor=#d5e8d4;stroke