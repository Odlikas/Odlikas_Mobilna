ote0" value="Later changes (kid: Naš dogovor → Predloži promjenu, parent: Postavke → Dogovori s djecom) run the same loop." style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;fontColor=#555555;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="0" y="579" width="3548" height="20" as="geometry"/></mxCell><mxCell id="note1" value="Legend: green = start/success · blue = step · white = screen · yellow = decision · orange = external / waiting · purple = paid AI or Odlikaš+ · red = error / stop · dashed line = loop back" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;fontColor=#555555;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="0" y="601" width="3548" height="20" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>