<mxfile host="Odlikas-diagrams" pages="1"><diagram id="p-k06" name="K06 Učenje (focus rounds and breaks)"><mxGraphModel adaptiveColors="auto"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="K06 · Učenje (focus rounds and breaks)" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=18;fontColor=#222222;fontFamily=Helvetica;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="3012" height="30" as="geometry"/></mxCell><mxCell id="summary" value="Defaults by grade: 1–2 15/5, 3–4 20/5, 5–8 25/5 min. After 4 rounds a 15 min long break. Skipping focus needs a confirm and the round doesn't count; skipping a break is fine; a pause over 10 min resets the round." style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=12;fontColor=#222222;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="0" y="30" width="3012" height="34" as="geometry"/></mxCell><mxCell id="lane0" value="Kid app" style="swimlane;horizontal=0;startSize=34;fillColor=#EAF5FB;swimlaneFillColor=#EAF5FB;strokeColor=#BBBBBB;fontStyle=1;fontSize=13;html=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="0" y="70" width="3012" height="646" as="geometry"/></mxCell><mxCell id="lane1" value="Server" style="swimlane;horizontal=0;startSize=34;fillColor=#F1F1F1;swimlaneFillColor=#F1F1F1;strokeColor=#BBBBBB;fontStyle=1;fontSize=13;html=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="0" y="716" width="3012" height="114" as="geometry"/></mxCell><mxCell id="s" value="Kid: Učenje tab or task" style="ellipse;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="74" y="116" width="152" height="52" as="geometry"/></mxCell><mxCell id="setup" value="Učenje odabir&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;(6 offline sounds, ? kako radi)&lt;/font&gt;" style="rounded=1;arcSize=12;fillColor=#ffffff;strokeColor=#1794D2;strokeWidth=2;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="332" y="107" width="172" height="70" as="geometry"/></mxCell><mxCell id="focus" value="Focus timer" style="rounded=1;arcSize=12;fillColor=#ffffff;strokeColor=#1794D2;strokeWidth=2;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="600" y="117" width="172" height="50" as="geometry"/></mxCell><mxCell id="ev" value="What happens?" style="rhombus;fillColor=#fff2cc;strokeColor=#d6b656;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="868" y="100" width="172" height="84" as="geometry"/></mxCell><mxCell id="skipc" value="Preskoči? confirm sheet" style="rounded=1;arcSize=12;fillColor=#ffffff;strokeColor=#1794D2;strokeWidth=2;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1136" y="117" width="172" height="50" as="geometry"/></mxCell><mxCell id="skq" value="Skip?" style="rhombus;fillColor=#fff2cc;strokeColor=#d6b656;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1404" y="100" width="172" height="84" as="geometry"/></mxCell><mxCell id="nocount" value="Round not counted" style="rounded=1;arcSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1672" y="117" width="172" height="50" as="geometry"/></mxCell><mxCell id="pause" value="Pauzirano" style="rounded=1;arcSize=12;fillColor=#ffffff;strokeColor=#1794D2;strokeWidth=2;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1136" y="229" width="172" height="50" as="geometry"/></mxCell><mxCell id="pl" value="Paused &amp;gt; 10 min?" style="rhombus;fillColor=#fff2cc;strokeColor=#d6b656;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1404" y="212" width="172" height="84" as="geometry"/></mxCell><mxCell id="reset" value="Round restarts" style="rounded=1;arcSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1672" y="229" width="172" height="50" as="geometry"/></mxCell><mxCell id="photo" value="Slikaj zadatak (K07)&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;timer paused&lt;/font&gt;" style="rounded=1;arcSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1136" y="339" width="172" height="54" as="geometry"/></mxCell><mxCell id="round" value="Round counted" style="rounded=1;arcSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1136" y="453" width="172" height="50" as="geometry"/></mxCell><mxCell id="r4" value="4th round?" style="rhombus;fillColor=#fff2cc;strokeColor=#d6b656;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1404" y="324" width="172" height="84" as="geometry"/></mxCell><mxCell id="short" value="Short break 5 min&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;(udahni / izdahni, skippable)&lt;/font&gt;" style="rounded=1;arcSize=12;fillColor=#ffffff;strokeColor=#1794D2;strokeWidth=2;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1672" y="331" width="172" height="70" as="geometry"/></mxCell><mxCell id="long" value="Duga pauza 15 min" style="rounded=1;arcSize=12;fillColor=#ffffff;strokeColor=#1794D2;strokeWidth=2;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1672" y="453" width="172" height="50" as="geometry"/></mxCell><mxCell id="done" value="Učenje gotovo" style="rounded=1;arcSize=12;fillColor=#ffffff;strokeColor=#1794D2;strokeWidth=2;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica