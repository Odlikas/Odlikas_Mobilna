<mxfile host="Odlikas-diagrams" pages="1"><diagram id="p-p03" name="P03 e-Dnevnik login and sync (parent app)"><mxGraphModel adaptiveColors="auto"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="P03 · e-Dnevnik login and sync (parent app)" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=18;fontColor=#222222;fontFamily=Helvetica;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="5424" height="30" as="geometry"/></mxCell><mxCell id="summary" value="Runs when the parent app opens and once a day in the background. The kid's login lives only in the parent phone's keystore." style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=12;fontColor=#222222;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="0" y="30" width="5424" height="34" as="geometry"/></mxCell><mxCell id="lane0" value="Parent app" style="swimlane;horizontal=0;startSize=34;fillColor=#FDF3E7;swimlaneFillColor=#FDF3E7;strokeColor=#BBBBBB;fontStyle=1;fontSize=13;html=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="0" y="70" width="5424" height="455" as="geometry"/></mxCell><mxCell id="lane1" value="External" style="swimlane;horizontal=0;startSize=34;fillColor=#FFF8E8;swimlaneFillColor=#FFF8E8;strokeColor=#BBBBBB;fontStyle=1;fontSize=13;html=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="0" y="525" width="5424" height="114" as="geometry"/></mxCell><mxCell id="lane2" value="Server" style="swimlane;horizontal=0;startSize=34;fillColor=#F1F1F1;swimlaneFillColor=#F1F1F1;strokeColor=#BBBBBB;fontStyle=1;fontSize=13;html=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="0" y="639" width="5424" height="196" as="geometry"/></mxCell><mxCell id="s" value="Parent app opens&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;or daily background task&lt;/font&gt;" style="ellipse;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="74" y="140" width="152" height="58" as="geometry"/></mxCell><mxCell id="has" value="Child's login saved&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;on this phone?&lt;/font&gt;" style="rhombus;fillColor=#fff2cc;strokeColor=#d6b656;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="332" y="118" width="172" height="101" as="geometry"/></mxCell><mxCell id="other" value="Other parent is the syncer?" style="rhombus;fillColor=#fff2cc;strokeColor=#d6b656;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="600" y="126" width="172" height="84" as="geometry"/></mxCell><mxCell id="view" value="Show synced data only" style="ellipse;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="878" y="142" width="152" height="52" as="geometry"/></mxCell><mxCell id="enter" value="Enter kid's e-Dnevnik login&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;(AAI@EduHr)&lt;/font&gt;" style="rounded=1;arcSize=12;fillColor=#ffffff;strokeColor=#1794D2;strokeWidth=2;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="868" y="262" width="172" height="70" as="geometry"/></mxCell><mxCell id="store" value="Save in secure keystore&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;this parent becomes the syncer&lt;/font&gt;" style="rounded=1;arcSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1136" y="134" width="172" height="70" as="geometry"/></mxCell><mxCell id="each" value="Next child, one at a time" style="rounded=1;arcSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1404" y="142" width="172" height="54" as="geometry"/></mxCell><mxCell id="login" value="Log in to e-Dnevnik" style="rounded=1;arcSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1672" y="557" width="172" height="50" as="geometry"/></mxCell><mxCell id="lok" value="Login ok?" style="rhombus;fillColor=#fff2cc;strokeColor=#d6b656;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1940" y="126" width="172" height="84" as="geometry"/></mxCell><mxCell id="lerr" value="sync_runs: login_error" style="shape=cylinder3;boundedLbl=1;size=8;fillColor=#d5e8d4;strokeColor=#82b366;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="2208" y="721" width="172" height="50" as="geometry"/></mxCell><mxCell id="three" value="Failed 3 days in a row?" style="rhombus;fillColor=#fff2cc;strokeColor=#d6b656;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="2476" y="704" width="172" height="84" as="geometry"/></mxCell><mxCell id="ask" value="Ask parent to re-enter login" style="rounded=1;arcSize=12;fillColor=#f8cecc;strokeColor=#b85450;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="2744" y="142" width="172" height="54" as="geometry"/></mxCell><mxCell id="retry" value="Retry next run" style="ellipse;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="2754" y="272" width="152" height="52" as="geometry"/></mxCell><mxCell id="fetch" value="Fetch grades, timetable,&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;tests, subjects pages&lt;/font&gt;" style="rounded=1;arcSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="2208" y="555" width="172" height="54" as="geometry"/></mxCell><mxCell id="parse" value="Parse on device&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;(packages/ednevnik)&lt;/font&gt;" style="rounded=1;arcSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="2476" y="142" width="172" height="54" as="geometry"/></mxCell><mxCell id="pok" value="Parse ok?" style="rhombus;fillColor=#fff2cc;strokeColor=#d6b656;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="2744" y="384" width="172" height="84" as="geometry"/></mxCell><mxCell id="perr" value="sync_runs: failed + error_code&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;alert team, keep old data&lt;/font&gt;" style="rounded=1;arcSize=12;fillColor=#f8cecc;strokeColor=#b85450;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="3012" y="703" width="172" height="86" as="geometry"/></mxCell><mxCell id="hash" value="Hash each row → source_hash" style="rounded=1;arcSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="3012" y="142" width="172" height="54" as="geometry"/></mxCell><mxCell id="up" value="Upsert grades, timetable_entries,&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;calendar_events, child_subjects&lt;/font&gt;" style="shape=cylinder3;boundedLbl=1;size=8;fillColor=#d5e8d4;strokeColor=#82b366;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="3280" y="703" width="172" height="86" as="geometry"/></mxCell><mxCell id="newg" value="New grade rows?" style="rhombus;fillColor=#fff2cc;strokeColor=#d6b656;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="3548" y="704" width="172" height="84" as="geometry"/></mxCell><mxCell id="trig" value="Trigger: notification&lt;br&gt;&lt;font style='font-size:10px' color='#555555