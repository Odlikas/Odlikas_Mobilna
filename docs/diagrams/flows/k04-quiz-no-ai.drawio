<mxfile host="Odlikas-diagrams" pages="1"><diagram id="p-k04" name="K04 Quiz (no AI)"><mxGraphModel adaptiveColors="auto"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="K04 · Quiz (no AI)" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=18;fontColor=#222222;fontFamily=Helvetica;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="3548" height="30" as="geometry"/></mxCell><mxCell id="summary" value="Topic: the kid's chosen topic, or the subject of an e-Dnevnik test this week; 'Ne znam' → review quiz. Only correct typed answers count." style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=12;fontColor=#222222;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="0" y="30" width="3548" height="34" as="geometry"/></mxCell><mxCell id="lane0" value="Kid app" style="swimlane;horizontal=0;startSize=34;fillColor=#EAF5FB;swimlaneFillColor=#EAF5FB;strokeColor=#BBBBBB;fontStyle=1;fontSize=13;html=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="0" y="70" width="3548" height="342" as="geometry"/></mxCell><mxCell id="lane1" value="Server" style="swimlane;horizontal=0;startSize=34;fillColor=#F1F1F1;swimlaneFillColor=#F1F1F1;strokeColor=#BBBBBB;fontStyle=1;fontSize=13;html=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="0" y="412" width="3548" height="130" as="geometry"/></mxCell><mxCell id="s" value="Kid starts a quiz" style="ellipse;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="74" y="133" width="152" height="52" as="geometry"/></mxCell><mxCell id="quota" value="Quota left? (B03)&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;Free: 3 per ISO week&lt;/font&gt;" style="rhombus;fillColor=#fff2cc;strokeColor=#d6b656;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="332" y="100" width="172" height="118" as="geometry"/></mxCell><mxCell id="lock" value="Limit: 3 kviza ovaj tjedan&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;(offer only to the parent)&lt;/font&gt;" style="rounded=1;arcSize=12;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="600" y="116" width="172" height="86" as="geometry"/></mxCell><mxCell id="lockend" value="Back to plan" style="ellipse;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="878" y="133" width="152" height="52" as="geometry"/></mxCell><mxCell id="pick" value="Odabir teme / topic from plan&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;Slikaj knjigu → 10 AI questions&lt;/font&gt;" style="rounded=1;arcSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="600" y="262" width="172" height="86" as="geometry"/></mxCell><mxCell id="math" value="Math outcome?" style="rhombus;fillColor=#fff2cc;strokeColor=#d6b656;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="868" y="263" width="172" height="84" as="geometry"/></mxCell><mxCell id="gen" value="Generator + new random seed" style="rounded=1;arcSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1136" y="132" width="172" height="54" as="geometry"/></mxCell><mxCell id="bank" value="Bank item from pack,&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;not seen in 14 days&lt;/font&gt;" style="rounded=1;arcSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1136" y="278" width="172" height="54" as="geometry"/></mxCell><mxCell id="q" value="Show question;&lt;br&gt;&lt;font 