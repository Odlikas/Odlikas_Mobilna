<mxfile host="Odlikas-diagrams" pages="1"><diagram id="p-p07" name="P07 Slikani zadaci (homework photos the parent sees)"><mxGraphModel adaptiveColors="auto"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="P07 · Slikani zadaci (homework photos the parent sees)" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=18;fontColor=#222222;fontFamily=Helvetica;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="2208" height="30" as="geometry"/></mxCell><mxCell id="summary" value="Homework photos are a bonus, not a gate (K08). The parent sees them afterwards and can react; nothing waits for parent approval. Replaces the old Odobri / Vrati review." style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=12;fontColor=#222222;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="0" y="30" width="2208" height="34" as="geometry"/></mxCell><mxCell id="lane0" value="Server" style="swimlane;horizontal=0;startSize=34;fillColor=#F1F1F1;swimlaneFillColor=#F1F1F1;strokeColor=#BBBBBB;fontStyle=1;fontSize=13;html=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="0" y="70" width="2208" height="130" as="geometry"/></mxCell><mxCell id="lane1" value="Parent app" style="swimlane;horizontal=0;startSize=34;fillColor=#FDF3E7;swimlaneFillColor=#FDF3E7;strokeColor=#BBBBBB;fontStyle=1;fontSize=13;html=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="0" y="200" width="2208" height="368" as="geometry"/></mxCell><mxCell id="lane2" value="Kid app" style="swimlane;horizontal=0;startSize=34;fillColor=#EAF5FB;swimlaneFillColor=#EAF5FB;strokeColor=#BBBBBB;fontStyle=1;fontSize=13;html=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="0" y="568" width="2208" height="112" as="geometry"/></mxCell><mxCell id="s" value="Kid sent a homework photo (K08)" style="ellipse;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;" vertex="1" p