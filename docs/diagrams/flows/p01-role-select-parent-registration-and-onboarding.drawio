<mxfile host="Odlikas-diagrams" pages="1"><diagram id="p-p01" name="P01 Role select, parent registration and onboarding"><mxGraphModel adaptiveColors="auto"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="P01 · Role select, parent registration and onboarding" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=18;fontColor=#222222;fontFamily=Helvetica;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="3280" height="30" as="geometry"/></mxCell><mxCell id="summary" value="One APK opens on the role select (roditelj / učenik / srednjoškolac). The parent registers, adds and pairs a child, optionally links e-Dnevnik, then proposes the dogovor (P13)." style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=12;fontColor=#222222;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="0" y="30" width="3280" height="34" as="geometry"/></mxCell><mxCell id="lane0" value="Parent app" style="swimlane;horizontal=0;startSize=34;fillColor=#FDF3E7;swimlaneFillColor=#FDF3E7;strokeColor=#BBBBBB;fontStyle=1;fontSize=13;html=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="0" y="70" width="3280" height="392" as="geometry"/></mxCell><mxCell id="lane1" value="Kid app" style="swimlane;horizontal=0;startSize=34;fillColor=#EAF5FB;swimlaneFillColor=#EAF5FB;strokeColor=#BBBBBB;fontStyle=1;fontSize=13;html=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="0" y="462" width="3280" height="112" as="geometry"/></mxCell><mxCell id="lane2" value="High-school app" style="swimlane;horizontal=0;startSize=34;fillColor=#EEF6EA;swimlaneFillColor=#EEF6EA;strokeColor=#BBBBBB;fontStyle=1;fontSize=13;html=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="0" y="574" width="3280" height="112" as="geometry"/></mxCell><mxCell id="lane3" value="Server" style="swimlane;horizontal=0;startSize=34;fillColor=#F1F1F1;swimlaneFillColor=#F1F1F1;strokeColor=#BBBBBB;fontStyle=1;fontSize=13;html=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="0" y="686" width="3280" height="130" as="geometry"/></mxCell><mxCell id="s" value="App opens&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;(one APK for everyone)&lt;/font&gt;" style="ellipse;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="74" y="123" width="152" height="58" as="geometry"/></mxCell><mxCell id="role" value="Odabir uloge" style="rounded=1;arcSize=12;fillColor=#ffffff;strokeColor=#1794D2;strokeWidth=2;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="332" y="127" width="172" height="50" as="geometry"/></mxCell><mxCell id="rq" value="Role?" style="rhombus;fillColor=#fff2cc;strokeColor=#d6b656;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="600" y="110" width="172" height="84" as="geometry"/></mxCell><mxCell id="kid" value="→ K01 Dijete povezivanje" style="ellipse;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="878" y="492" width="152" height="52" as="geometry"/></mxCell><mxCell id="hs" value="→ H01 Srednja prijava" style="ellipse;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="878" y="604" width="152" height="52" as="geometry"/></mxCell><mxCell id="acc" value="Has an account?" style="rhombus;fillColor=#fff2cc;strokeColor=#d6b656;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="868" y="110" width="172" height="84" as="geometry"/></mxCell><mxCell id="login" value="Prijava&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;(e-mail + lozinka)&lt;/font&gt;" style="rounded=1;arcSize=12;fillColor=#ffffff;strokeColor=#1794D2;strokeWidth=2;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1136" y="125" width="172" height="54" as="geometry"/></mxCell><mxCell id="lok" value="Login ok?" style="rhombus;fillColor=#fff2cc;strokeColor=#d6b656;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1404" y="110" width="172" height="84" as="geometry"/></mxCell><mxCell id="forgot" value="Zaboravljena lozinka →&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;e-mail link → nova lozinka&lt;/font&gt;" style="rounded=1;arcSize=12;fillColor=#ffffff;strokeColor=#1794D2;strokeWidth=2;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1672" y="117" width="172" height="70" as="geometry"/></mxCell><mxCell id="home" value="Roditelj - početna" style="ellipse;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1682" y="240" width="152" height="52" as="geometry"/></mxCell><mxCell id="reg" value="Registracija&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;(e-mail, lozinka, consents)&lt;/font&gt;" style="rounded=1;arcSize=12;fillColor=#ffffff;strokeColor=#1794D2;strokeWidth=2;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1136" y="231" width="172" height="70" as="geometry"/></mxCell><mxCell id="auth" value="Supabase Auth user +&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;families, parents (owner), consents&lt;/font&gt;" style="shape=cylinder3;boundedLbl=1;size=8;fillColor=#d5e8d4;strokeColor=#82b366;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1404" y="716" width="172" height="70" as="geometry"/></mxCell><mxCell id="child" value="Dodaj dijete: name, grade,&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;parent label (mama / tata / …)&lt;/font&gt;" style="rounded=1;arcSize=12;fillColor=#ffffff;strokeColor=#1794D2;strokeWidth=2;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1672" y="337" width="172" height="86" as="geometry"/></mxCell><mxCell id="pair" value="Pair the kid's phone (P02)&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;→ Dijete povezano&lt;/font&gt;" style="rounded=1;arcSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1940" y="117" width="172" height="70" as="geometry"/></mxCell><mxCell id="ed" value="Link e-Dnevnik now?" style="rhombus;fillColor=#fff2cc;strokeColor=#d6b656;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="2208" y="110" width="172" height="84" as="geometry"/></mxCell><mxCell id="p03" value="e-Dnevnik login +&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;first sync (P03)&lt;/font&gt;" style="rounded=1;arcSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="2476" y="125" width="172" height="54" as="geometry"/></mxCell><mxCell id="week" value="Lukin prvi tjedan&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;(autopilot plan preview)&lt;/font&gt;" style="rounded=1;arcSize=12;fillColor=#ffffff;strokeColor=#1794D2;strokeWidth=2;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="2744" y="125" width="172" height="54" as="geometry"/></mxCell><mxCell id="dog" value="→ P13 dogovor s djetetom" style="ellipse;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="3022" y="126" width="152" height="52" as="geometry"/></mxCell><mxCell id="e0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;endFill=1;strokeColor=#555555;labelBackgroundColor=default;ex