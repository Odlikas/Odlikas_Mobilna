e=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;endFill=1;strokeColor=#555555;labelBackgroundColor=default;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="week" target="dog"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="note0" value="Kids never register themselves. The parent label chosen here replaces 'mama' in every kid screen." style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;fontColor=#555555;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="0" y="832" width="3280" height="20" as="geometry"/></mxCell><mxCell id="note1" value="Legend: green = start/success · blue = step · white = screen · yellow = decision · orange = external / waiting · purple = paid AI or Odlikaš+ · red = error / stop · dashed line = loop back" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;fontColor=#555555;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="0" y="854" width="3280" height="20" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>