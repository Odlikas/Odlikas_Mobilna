<mxfile host="Odlikas-diagrams" pages="1"><diagram id="p-k03" name="K03 Lock and unlock engine"><mxGraphModel adaptiveColors="auto"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="K03 · Lock and unlock engine" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=18;fontColor=#222222;fontFamily=Helvetica;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1940" height="30" as="geometry"/></mxCell><mxCell id="summary" value="Every task earns minutes ('Svaki zadatak ti donosi minute'), finishing all of them gives +60 (copy to confirm). Extra grants: homework photo, streak and goal rewards, time requests, parent's manual unlock. Never AI." style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=12;fontColor=#222222;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="0" y="30" width="1940" height="34" as="geometry"/></mxCell><mxCell id="lane0" value="Kid app" style="swimlane;horizontal=0;startSize=34;fillColor=#EAF5FB;swimlaneFillColor=#EAF5FB;strokeColor=#BBBBBB;fontStyle=1;fontSize=13;html=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="0" y="70" width="1940" height="461" as="geometry"/></mxCell><mxCell id="lane1" value="Server" style="swimlane;horizontal=0;startSize=34;fillColor=#F1F1F1;swimlaneFillColor=#F1F1F1;strokeColor=#BBBBBB;fontStyle=1;fontSize=13;html=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="0" y="531" width="1940" height="114" as="geometry"/></mxCell><mxCell id="lane2" value="Parent app" style="swimlane;horizontal=0;startSize=34;fillColor=#FDF3E7;swimlaneFillColor=#FDF3E7;strokeColor=#BBBBBB;fontStyle=1;fontSize=13;html=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="0" y="645" width="1940" height="112" as="geometry"/></mxCell><mxCell id="s" value="A task becomes done" style="ellipse;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="74" y="154" width="152" height="52" as="geometry"/></mxCell><mxCell id="per" value="+ that task's minutes" style="rounded=1;arcSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="332" y="155" width="172" height="50" as="geometry"/></mxCell><mxCell id="all" value="All of today's tasks done?" style="rhombus;fillColor=#fff2cc;strokeColor=#d6b656;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="600" y="138" width="172" height="84" as="geometry"/></mxCell><mxCell id="bonus" value="+60 min 'riješi sve' bonus" style="rounded=1;arcSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="868" y="153" width="172" height="54" as="geometry"/></mxCell><mxCell id="s3" value="Other grant: homework photo +15 (≤ 2/day),&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;streak (K16), goal reward (K15),&lt;br&gt;time request (P06)&lt;/font&gt;" style="ellipse;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="74" y="261" width="152" height="106" as="geometry"/></mxCell><mxCell id="man" value="Parent: Otključaj ručno" style="ellipse;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="74" y="675" width="152" height="52" as="geometry"/></mxCell><mxCell id="write" value="unlock_grants: one row per reason" style="shape=cylinder3;boundedLbl=1;size=8;fillColor=#d5e8d4;strokeColor=#82b366;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1136" y="153" width="172" height="54" as="geometry"/></mxCell><mxCell id="sync" value="Sync + server re-check (B06)" style="rounded=1;arcSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1404" y="561" width="172" height="54" as="geometry"/></mxCell><mxCell id="open" value="Otključano: minutes added" style="ellipse;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1682" y="151" width="152" height="58" as="geometry"/></mxCell><mxCell id="s2" value="Kid opens a locked app" style="ellipse;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="74" y="422" width="152" height="52" as="geometry"/></mxCell><mxCell id="left" value="Minutes left today?&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;(grants − used)&lt;/font&gt;" style="rhombus;fillColor=#fff2cc;strokeColor=#d6b656;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="332" y="264" width="172" height="101" as="geometry"/></mxCell><mxCell id="lock" value="Zaključana aplikacija: tasks,&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;slikaj zadaću, zamoli za vrijeme&lt;/font&gt;" style="ellipse;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="610" y="269" width="152" height="90" as="geometry"/></mxCell><mxCell id="allow" value="Allow; count usage_daily minutes" style="rounded=1;arcSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="600" y="421" width="172" height="54" as="geometry"/></mxCell><mxCell id="out" value="Minutes run out?" style="rhombus;fillColor=#fff2cc;strokeColor=#d6b656;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="868" y="272" width="172" height="84" as="geometry"/></mxCell><mxCell id="over" value="Vrijeme isteklo →&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;zamoli još 15 min / početna&lt;/font&gt;" style="ellipse;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1146" y="277" width="152" height="74" as="geometry"/></mxCell><mxCell id="play" value="Playing" style="ellipse;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1146" y="422" width="152" height="52" as="geometry"/></mxCell><mxCell id="e0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;endFill=1;strokeColor=#555555;labelBackgroundColor=default;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="s" target="per"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;endFill=1;strokeColor=#555555;labelBackgroundColor=default;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="per" target="all"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e2" value="Yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;endFill=1;strokeColor=#555555;labelBackgroundColor=default;fontColor=#2D7600;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="all" target="bonus"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e3" value="No" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;endFill=1;strokeColor=#555555;labelBackgroundColor=default;fontColor=#B20000;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="all" target="write"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="786" y="180"/><mxPoint x="786" y="78"/><mxPoint x="1122" y="78"/><mxPoint x="1122" y="180"/></Array></mxGeometry></mxCell><mx