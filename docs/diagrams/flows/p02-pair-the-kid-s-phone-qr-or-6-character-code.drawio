<mxfile host="Odlikas-diagrams" pages="1"><diagram id="p-p02" name="P02 Pair the kid's phone (QR or 6-character code)"><mxGraphModel adaptiveColors="auto"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="P02 · Pair the kid's phone (QR or 6-character code)" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=18;fontColor=#222222;fontFamily=Helvetica;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="2476" height="30" as="geometry"/></mxCell><mxCell id="summary" value="Parent creates a code, kid phone claims it. Code: 6 chars from ABCDEFGHJKMNPQRSTUVWXYZ23456789, valid 10 min, single use." style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=12;fontColor=#222222;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="0" y="30" width="2476" height="34" as="geometry"/></mxCell><mxCell id="lane0" value="Parent app" style="swimlane;horizontal=0;startSize=34;fillColor=#FDF3E7;swimlaneFillColor=#FDF3E7;strokeColor=#BBBBBB;fontStyle=1;fontSize=13;html=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="0" y="70" width="2476" height="260" as="geometry"/></mxCell><mxCell id="lane1" value="Kid app" style="swimlane;horizontal=0;startSize=34;fillColor=#EAF5FB;swimlaneFillColor=#EAF5FB;strokeColor=#BBBBBB;fontStyle=1;fontSize=13;html=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="0" y="330" width="2476" height="162" as="geometry"/></mxCell><mxCell id="lane2" value="Server" style="swimlane;horizontal=0;startSize=34;fillColor=#F1F1F1;swimlaneFillColor=#F1F1F1;strokeColor=#BBBBBB;fontStyle=1;fontSize=13;html=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="0" y="492" width="2476" height="170" as="geometry"/></mxCell><mxCell id="s" value="Parent: child → Dodaj uređaj" style="ellipse;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="74" y="114" width="152" height="58" as="geometry"/></mxCell><mxCell id="create" value="create_pairing_code(child)&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;retry on collision&lt;/font&gt;" style="rounded=1;arcSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="332" y="538" width="172" height="70" as="geometry"/></mxCell><mxCell id="show" value="Show QR odlikas://pair?c=CODE&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;+ code to type + 10 min countdown&lt;/font&gt;" style="rounded=1;arcSize=12;fillColor=#ffffff;strokeColor=#1794D2;strokeWidth=2;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="600" y="100" width="172" height="86" as="geometry"/></mxCell><mxCell id="exp" value="Claimed before expiry?" style="rhombus;fillColor=#fff2cc;strokeColor=#d6b656;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="868" y="101" width="172" height="84" as="geometry"/></mxCell><mxCell id="newcode" value="Generate new code" style="rounded=1;arcSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1136" y="118" width="172" height="50" as="geometry"/></mxCell><mxCell id="ok" value="Uređaj povezan ✓&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;(realtime on devices)&lt;/font&gt;" style="ellipse;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1146" y="228" width="152" height="58" as="geometry"/></mxCell><mxCell id="k" value="Kid phone: Odlikaš → Ja sam učenik" style="ellipse;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="74" y="373" width="152" height="58" as="geometry"/></mxCell><mxCell id="scr" value="Pairing screen&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;scan QR or type code&lt;/font&gt;" style="rounded=1;arcSize=12;fillColor=#ffffff;strokeColor=#1794D2;strokeWidth=2;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="332" y="375" width="172" height="54" as="geometry"/></mxCell><mxCell id="parse" value="PairingPayload.parse&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;uppercase, strip spaces and -&lt;/font&gt;" style="rounded=1;arcSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="600" y="367" width="172" height="70" as="geometry"/></mxCell><mxCell id="fmt" value="6 valid chars?" style="rhombus;fillColor=#fff2cc;strokeColor=#d6b656;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="868" y="360" width="172" height="84" as="geometry"/></mxCell><mxCell id="bad" value="Krivi kod, try again" style="rounded=1;arcSize=12;fillColor=#f8cecc;strokeColor=#b85450;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1136" y="377" width="172" height="50" as="geometry"/></mxCell><mxCell id="anon" value="Anonymous sign-in&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;(child device user)&lt;/font&gt;" style="rounded=1;arcSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1136" y="546" width="172" height="54" as="geometry"/></mxCell><mxCell id="claim" value="claim_pairing_code&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;(code, platform, app_version)&lt;/font&gt;" style="rounded=1;arcSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1404" y="538" width="172" height="70" as="geometry"/></mxCell><mxCell id="valid" value="Code exists, unused, not expired?" style="rhombus;fillColor=#fff2cc;strokeColor=#d6b656;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1672" y="522" width="172" height="101" as="geometry"/></mxCell><mxCell id="inv" value="Kod je istekao ili iskorišten&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;ask parent for a new one&lt;/font&gt;" style="rounded=1;arcSize=12;fillColor=#f8cecc;strokeColor=#b85450;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1940" y="367" width="172" height="70" as="geometry"/></mxCell><mxCell id="link" value="children.auth_user_id = uid&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;old device revoked_at, insert devices&lt;/font&gt;" style="shape=cylinder3;boundedLbl=1;size=8;fillColor=#d5e8d4;strokeColor=#82b366;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1940" y="530" width="172" height="86" as="geometry"/></mxCell><mxCell id="done" value="Povezano → dogovor (P13),&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;then dopuštenja (K01)&lt;/font&gt;" style="ellipse;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="2218" y="365" width="152" height="74" as="geometry"/></mxCell><mxCell id="e0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;endFill=1;strokeColor=#555555;labelBackgroundColor=default;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="s" target="create"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;endFill=1;strokeColor=#555555;labelBackgroundColor=default;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="create" target="show"><mxGeometry relative="1" as="geometry"></mxGeometry></m