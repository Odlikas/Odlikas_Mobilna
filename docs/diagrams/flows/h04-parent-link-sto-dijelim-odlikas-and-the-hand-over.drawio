<mxfile host="Odlikas-diagrams" pages="1"><diagram id="p-h04" name="H04 Parent link, Što dijelim, Odlikaš+ and the hand-over"><mxGraphModel adaptiveColors="auto"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="H04 · Parent link, Što dijelim, Odlikaš+ and the hand-over" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=18;fontColor=#222222;fontFamily=Helvetica;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1940" height="30" as="geometry"/></mxCell><mxCell id="summary" value="The student invites a parent and picks what is shared. Under 18 there are no buy buttons, only 'Zamoli roditelja' (max once a week); 18+ pays the same plan. At the move to high school the parent hands over control." style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=12;fontColor=#222222;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="0" y="30" width="1940" height="34" as="geometry"/></mxCell><mxCell id="lane0" value="High-school app" style="swimlane;horizontal=0;startSize=34;fillColor=#EEF6EA;swimlaneFillColor=#EEF6EA;strokeColor=#BBBBBB;fontStyle=1;fontSize=13;html=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="0" y="70" width="1940" height="265" as="geometry"/></mxCell><mxCell id="lane1" value="Parent app" style="swimlane;horizontal=0;startSize=34;fillColor=#FDF3E7;swimlaneFillColor=#FDF3E7;strokeColor=#BBBBBB;fontStyle=1;fontSize=13;html=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="0" y="335" width="1940" height="256" as="geometry"/></mxCell><mxCell id="lane2" value="Server" style="swimlane;horizontal=0;startSize=34;fillColor=#F1F1F1;swimlaneFillColor=#F1F1F1;strokeColor=#BBBBBB;fontStyle=1;fontSize=13;html=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="0" y="591" width="1940" height="130" as="geometry"/></mxCell><mxCell id="lane3" value="External" style="swimlane;horizontal=0;startSize=34;fillColor=#FFF8E8;swimlaneFillColor=#FFF8E8;strokeColor=#BBBBBB;fontStyle=1;fontSize=13;html=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="0" y="721" width="1940" height="110" as="geometry"/></mxCell><mxCell id="s" value="Profil → Roditelj" style="ellipse;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="74" y="125" width="152" height="52" as="geometry"/></mxCell><mxCell id="inv" value="Poveži roditelja →&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;Pošalji pozivnicu&lt;/font&gt;" style="rounded=1;arcSize=12;fillColor=#ffffff;strokeColor=#1794D2;strokeWidth=2;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="332" y="124" width="172" height="54" as="geometry"/></mxCell><mxCell id="pinv" value="Poziv od Ivana" style="rounded=1;arcSize=12;fillColor=#ffffff;strokeColor=#1794D2;strokeWidth=2;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="600" y="382" width="172" height="50" as="geometry"/></mxCell><mxCell id="pa" value="Parent?" style="rhombus;fillColor=#fff2cc;strokeColor=#d6b656;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="868" y="365" width="172" height="84" as="geometry"/></mxCell><mxCell id="share" value="Što dijelim&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;(grades, focus, matura …)&lt;/font&gt;" style="rounded=1;arcSize=12;fillColor=#ffffff;strokeColor=#1794D2;strokeWidth=2;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1136" y="116" width="172" height="70" as="geometry"/></mxCell><mxCell id="save" value="sharing scopes:&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;the parent sees only these&lt;/font&gt;" style="shape=cylinder3;boundedLbl=1;size=8;fillColor=#d5e8d4;strokeColor=#82b366;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1404" y="621" width="172" height="70" as="geometry"/></mxCell><mxCell id="linked" value="Roditelj - Ivan (srednja)" style="ellipse;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1682" y="378" width="152" height="58" as="geometry"/></mxCell><mxCell id="nolink" value="Not linked" style="ellipse;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1146" y="237" width="152" height="52" as="geometry"/></mxCell><mxCell id="s2" value="Profil → Odlikaš+" style="ellipse;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="74" y="237" width="152" height="52" as="geometry"/></mxCell><mxCell id="age" value="18+?" style="rhombus;fillColor=#fff2cc;strokeColor=#d6b656;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="332" y="221" width="172" height="84" as="geometry"/></mxCell><mxCell id="self" value="Google Play (same plan)" style="rounded=1;arcSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="600" y="751" width="172" height="50" as="geometry"/></mxCell><mxCell id="act" value="Odlikaš+ active" style="ellipse;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="878" y="125" width="152" height="52" as="geometry"/></mxCell><mxCell id="ask" value="ZAMOLI RODITELJA&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;(max once a week)&lt;/font&gt;" style="rounded=1;arcSize=12;fillColor=#ffffff;strokeColor=#1794D2;strokeWidth=2;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="600" y="124" width="172" height="54" as="geometry"/></mxCell><mxCell id="pr" value="Parent: ISPROBAJ 14 DANA (P10)" style="ellipse;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="878" y="490" width="152" height="58" as="geometry"/></mxCell><mxCell id="s3" value="Kid moves to high school" style="ellipse;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="74" y="630" width="152" height="52" as="geometry"/></mxCell><mxCell id="pt" value="Prelazak u srednju" style="rounded=1;arcSize=12;fillColor=#ffffff;strokeColor=#1794D2;strokeWidth=2;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="332" y="382" width="172" height="50" as="geometry"/></mxCell><mxCell id="hand" value="Od sada ti upravljaš" style="rounded=1;arcSize=12;fillColor=#ffffff;strokeColor=#1794D2;strokeWidth=2;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="600" y="238" width="172" height="50" as="geometry"/></mxCell><mxCell id="e0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;endFill=1;strokeColor=#555555;labelBackgroundColor=default;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="s" target="inv"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;endFill=1;strokeColor=#555555;labelBackgroundColor=default;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="inv" target="pinv"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;endFill=1;strokeColor=#555555;labelBackgroundColor=default;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="pinv" target="pa"