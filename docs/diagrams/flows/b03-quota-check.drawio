<mxfile host="Odlikas-diagrams" pages="1"><diagram id="p-b03" name="B03 Quota check"><mxGraphModel adaptiveColors="auto"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="B03 · Quota check" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=18;fontColor=#222222;fontFamily=Helvetica;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1940" height="30" as="geometry"/></mxCell><mxCell id="summary" value="usage_counters per child, feature, period. Free: 3 quizzes a week, 5 Pitaj Josu messages a day, 3 matura sets a week. Odlikaš+ (or trial): unlimited. Daily caps on paid photo AI stay." style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=12;fontColor=#222222;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="0" y="30" width="1940" height="34" as="geometry"/></mxCell><mxCell id="lane0" value="Server" style="swimlane;horizontal=0;startSize=34;fillColor=#F1F1F1;swimlaneFillColor=#F1F1F1;strokeColor=#BBBBBB;fontStyle=1;fontSize=13;html=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="0" y="70" width="1940" height="479" as="geometry"/></mxCell><mxCell id="s" value="Request: quiz, josu_message, matura_set,&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;photo_help, homework_check&lt;/font&gt;" style="ellipse;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="74" y="123" width="152" height="90" as="geometry"/></mxCell><mxCell id="feat" value="Feature?" style="rhombus;fillColor=#fff2cc;strokeColor=#d6b656;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="332" y="126" width="172" height="84" as="geometry"/></mxCell><mxCell id="plan" value="Odlikaš+ or trial?" style="rhombus;fillColor=#fff2cc;strokeColor=#d6b656;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="600" y="126" widt