<mxfile host="Odlikas-diagrams" pages="1"><diagram id="p-b04" name="B04 Odlikaš+ lifecycle (trial entitlement + store-webhook)"><mxGraphModel adaptiveColors="auto"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="B04 · Odlikaš+ lifecycle (trial entitlement + store-webhook)" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=18;fontColor=#222222;fontFamily=Helvetica;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="3548" height="30" as="geometry"/></mxCell><mxCell id="summary" value="The trial is a server entitlement; paid states come from RevenueCat events. families.plan is a cached copy." style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=12;fontColor=#222222;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="0" y="30" width="3548" height="34" as="geometry"/></mxCell><mxCell id="lane0" value="Server" style="swimlane;horizontal=0;startSize=34;fillColor=#F1F1F1;swimlaneFillColor=#F1F1F1;strokeColor=#BBBBBB;fontStyle=1;fontSize=13;html=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="0" y="70" width="3548" height="268" as="geometry"/></mxCell><mxCell id="lane1" value="External" style="swimlane;horizontal=0;startSize=34;fillColor=#FFF8E8;swimlaneFillColor=#FFF8E8;strokeColor=#BBBBBB;fontStyle=1;fontSize=13;html=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="0" y="338" width="3548" height="144" as="geometry"/></mxCell><mxCell id="lane2" value="Parent app" style="swimlane;horizontal=0;startSize=34;fillColor=#FDF3E7;swimlaneFillColor=#FDF3E7;strokeColor=#BBBBBB;fontStyle=1;fontSize=13;html=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="0" y="482" width="3548" height="290" as="geometry"/></mxCell><mxCell id="s" value="Dogovor signed (P13)" style="ellipse;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="74" y="155" width="152" height="52