<mxfile host="Odlikas-diagrams" pages="1"><diagram id="p-k05" name="K05 Smart flashcards (Odlikaš+)"><mxGraphModel adaptiveColors="auto"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="K05 · Smart flashcards (Odlikaš+)" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=18;fontColor=#222222;fontFamily=Helvetica;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="2476" height="30" as="geometry"/></mxCell><mxCell id="summary" value="Made from the kid's mistakes or after a 1–2 grade (Pametna obavijest). 5 cards, typed answers. Counts when all 5 are correct." style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=12;fontColor=#222222;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="0" y="30" width="2476" height="34" as="geometry"/></mxCell><mxCell id="lane0" value="Server" style="swimlane;horizontal=0;startSize=34;fillColor=#F1F1F1;swimlaneFillColor=#F1F1F1;strokeColor=#BBBBBB;fontStyle=1;fontSize=13;html=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="0" y="70" width="2476" height="144" as="geometry"/></mxCell><mxCell id="lane1" value="Kid app" style="swimlane;horizontal=0;startSize=34;fillColor=#EAF5FB;swimlaneFillColor=#EAF5FB;strokeColor=#BBBBBB;fontStyle=1;fontSize=13;html=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="0" y="214" width="2476" height="274" as="geometry"/></mxCell><mxCell id="s" value="Mistakes, or a new&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;1–2 grade (P03 / P14)&lt;/font&gt;" style="ellipse;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="74" y="113" width="152" height="58" as="geometry"/></mxCell><mxCell id="fol" value="Odlikaš+ or trial?" style="rhombus;fillColor=#fff2cc;strokeColor=#d6b656;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="332" y="100" width="172" height="84" as="geometry"/></mxCell><mxCell id="none" value="No flashcards" style="ellipse;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="610" y="116" width="152" height="52" as="geometry"/></mxCell><mxCell id="task" value="Next daily plan gets&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;5-flashcard task (K02)&lt;/font&gt;" style="rounded=1;arcSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="600" y="259" width="172" height="54" as="geometry"/></mxCell><mxCell id="cards" value="5 cards for that subject&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;(kind = flashcard)&lt;/font&gt;" style="rounded=1;arcSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="868" y="259" width="172" height="54" as="geometry"/></mxCell><mxCell id="show" value="Show card;&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;kid TYPES the answer&lt;/font&gt;" style="rounded=1;arcSize=12;fillColor=#ffffff;strokeColor=#1794D2;strokeWidth=2;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1136" y="259" width="172" height="54" as="geometry"/></mxCell><mxCell id="chk" value="Check (B01)" style="rounded=1;arcSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1404" y="261" width="172" height="50" as="geometry"/></mxCell><mxCell id="ok" value="Correct?" style="rhombus;fillColor=#fff2cc;strokeColor=#d6b656;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1672" y="244" width="172" height="84" as="geometry"/></mxCell><mxCell id="back" value="Card returns later&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;with new numbers&lt;/font&gt;" style="rounded=1;arcSize=12;fillColor=#f8cecc;strokeColor=#b85450;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1940" y="259" width="172" height="54" as="geometry"/></mxCell><mxCell id="all" value="All 5 correct?" style="rhombus;fillColor=#fff2cc;strokeColor=#d6b656;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1940" y="356" width="172" height="84" as="geometry"/></mxCell><mxCell id="done" value="Task done → K03" style="ellipse;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="2218" y="260" width="152" height="52" as="geometry"/></mxCell><mxCell id="e0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;endFill=1;strokeColor=#555555;labelBackgroundColor=default;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="s" target="fol"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e1" value="No" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;endFill=1;strokeColor=#555555;labelBackgroundColor=default;fontColor=#B20000;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="fol" target="none"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e2" value="Yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;endFill=1;strokeColor=#555555;labelBackgroundColor=default;fontColor=#2D7600;exitX=0.5;exitY=1;entryX=0;entryY=0.5;" edge="1" parent="1" source="fol" target="task"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;endFill=1;strokeColor=#555555;labelBackgroundColor=default;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="task" target