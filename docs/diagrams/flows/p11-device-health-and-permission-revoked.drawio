<mxfile host="Odlikas-diagrams" pages="1"><diagram id="p-p11" name="P11 Device health and permission revoked"><mxGraphModel adaptiveColors="auto"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="P11 · Device health and permission revoked" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=18;fontColor=#222222;fontFamily=Helvetica;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="2208" height="30" as="geometry"/></mxCell><mxCell id="summary" value="If the kid turns off a permission, apps can't be locked; the parent finds out right away." style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=12;fontColor=#222222;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="0" y="30" width="2208" height="34" as="geometry"/></mxCell><mxCell id="lane0" value="Kid app" style="swimlane;horizontal=0;startSize=34;fillColor=#EAF5FB;swimlaneFillColor=#EAF5FB;strokeColor=#BBBBBB;fontStyle=1;fontSize=13;html=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="0" y="70" width="2208" height="155" as="geometry"/></mxCell><mxCell id="lane1" value="Server" style="swimlane;horizontal=0;startSize=34;fillColor=#F1F1F1;swimlaneFillColor=#F1F1F1;strokeColor=#BBBBBB;fontStyle=1;fontSize=13;html=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="0" y="225" width="2208" height="144" as="geometry"/></mxCell><mxCell id="lane2" value="Parent app" style="swimlane;horizontal=0;startSize=34;fillColor=#FDF3E7;swimlaneFillColor=#FDF3E7;strokeColor=#BBBBBB;fontStyle=1;fontSize=13;html=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="0" y="369" width="2208" height="130" as="geometry"/></mxCell><mxCell id="s" value="Kid app opens or&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;6-hour heartbeat&lt;/font&gt;" style="ellipse;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="74" y="114" width="152" height="58" as="geometry"/></mxCell><mxCell id="chk" value="Check permissions&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;Android: accessibility, usage, notifications&lt;br&gt;iOS: FamilyControls&lt;/font&gt;" style="rounded=1;arcSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="332" y="100" width="172" height="86" as="geometry"/></mxCell><mxCell id="ok" value="All granted?" style="rhombus;fillColor=#fff2cc;strokeColor=#d6b656;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="600" y="101" width="172" height="84" as="geometry"/></mxCell><mxCell id="seen" value="devices.blocking_ok = true&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;last_seen_at&lt;/font&gt;" style="shape=cylinder3;boundedLbl=1;size=8;fillColor=#d5e8d4;strokeColor=#82b366;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="868" y="262" width="172" height="70" as="geometry"/></mxCell><mxCell id="fine" value="Normal use" style="ellipse;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1146" y="117" width="152" height="52" as="geometry"/></mxCell><mxCell id="kscr" value="Dopuštenje isključeno screen&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;how to turn it back on&lt;/font&gt;" style="rounded=1;arcSize=12;fillColor=#ffffff;strokeColor=#1794D2;strokeWidth=2;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="868" y="108" width="172" height="70" as="geometry"/></mxCell><mxCell id="bad" value="blocking_ok = false&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;notification permission_revoked&lt;/font&gt;" style="shape=cylinder3;boundedLbl=1;size=8;fillColor=#d5e8d4;strokeColor=#82b366;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1136" y="262" width="172" height="70" as="geometry"/></mxCell><mxCell id="alert" value="Alert: blokiranje isključeno&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;na Lukinom mobitelu&lt;/font&gt;" style="rounded=1;arcSize=12;fillColor=#ffffff;strokeColor=#1794D2;strokeWidth=2;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1404" y="399" width="172" height="70" as="geometry"/></mxCell><mxCell id="fixd" value="Permission turned back on?" style="rhombus;fillColor=#fff2cc;strokeColor=#d6b656;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1672" y="101" width="172" height="84" as="geometry"/></mxCell><mxCell id="wait" value="Stays on the warning screen" style="ellipse;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1950" y="114" width="152" height="58" as="geometry"/></mxCell><mxCell id="cron" value="Daily: last_seen_at &amp;gt; 48 h?" style="ellipse;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="74" y="268" width="152" height="58" as="geometry"/></mxCell><mxCell id="q" value="Device silent?" style="rhombus;fillColor=#fff2cc;strokeColor=#d6b656;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="332" y="255" width="172" height="84" as="geometry"/></mxCell><mxCell id="silent" value="Uređaj nije viđen 2 dana" style="ellipse;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="610" y="408" width="152" height="52" as="geometry"/></mxCell><mxCell id="quiet" value="Nothing to do" style="ellipse;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;whiteSpace=wrap;html=1;fontSize=12