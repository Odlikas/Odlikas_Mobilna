<mxfile host="Odlikas-diagrams" pages="1"><diagram id="p-p06-k09" name="P06 · K09 Request extra time (kid asks, parent decides)"><mxGraphModel adaptiveColors="auto"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="P06 · K09 · Request extra time (kid asks, parent decides)" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=18;fontColor=#222222;fontFamily=Helvetica;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="3548" height="30" as="geometry"/></mxCell><mxCell id="summary" value="Kid picks 15 / 30 / 60 min, a reason chip and/or a message (≤ 150 chars). Max 2 requests a day; the parent can change the cap." style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=12;fontColor=#222222;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="0" y="30" width="3548" height="34" as="geometry"/></mxCell><mxCell id="lane0" value="Kid app" style="swimlane;horizontal=0;startSize=34;fillColor=#EAF5FB;swimlaneFillColor=#EAF5FB;strokeColor=#BBBBBB;fontStyle=1;fontSize=13;html=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="0" y="70" width="3548" height="428" as="geometry"/></mxCell><mxCell id="lane1" value="Server" style="swimlane;horizontal=0;startSize=34;fillColor=#F1F1F1;swimlaneFillColor=#F1F1F1;strokeColor=#BBBBBB;fontStyle=1;fontSize=13;html=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="0" y="498" width="3548" height="374" as="geometry"/></mxCell><mxCell id="lane2" value="Parent app" style="swimlane;horizontal=0;startSize=34;fillColor=#FDF3E7;swimlaneFillColor=#FDF3E7;strokeColor=#BBBBBB;fontStyle=1;fontSize=13;html=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="0" y="872" width="3548" height="144" as="geometry"/></mxCell><mxCell id="s" value="Zamoli za vrijeme&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;(locked app or Vrijeme isteklo)&lt;/font&gt;" style="ellipse;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="74" y="114" width="152" height="74" as="geometry"/></mxCell><mxCell id="cap" value="Requests left today?&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;(default 2)&lt;/font&gt;" style="rhombus;fillColor=#fff2cc;strokeColor=#d6b656;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="332" y="100" width="172" height="101" as="geometry"/></mxCell><mxCell id="capno" value="Danas si već pitao 2 puta" style="ellipse;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="610" y="122" width="152" height="58" as="geometry"/></mxCell><mxCell id="pend" value="Request already pending?" style="rhombus;fillColor=#fff2cc;strokeColor=#d6b656;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="600" y="238" width="172" height="84" as="geometry"/></mxCell><mxCell id="wait" value="Zahtjev poslan, čekamo" style="ellipse;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="878" y="124" width="152" height="52" as="geometry"/></mxCell><mxCell id="form" value="15 / 30 / 60 min +&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;reason chip and/or message&lt;/font&gt;" style="rounded=1;arcSize=12;fillColor=#ffffff;strokeColor=#1794D2;strokeWidth=2;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="868" y="244" width="172" height="70" as="geometry"/></mxCell><mxCell id="clean" value="Message ≤ 150 chars&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;+ word list ok?&lt;/font&gt;" style="rhombus;fillColor=#fff2cc;strokeColor=#d6b656;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1136" y="100" width="172" height="101" as="geometry"/></mxCell><mxCell id="fix" value="Ask kid to change the text" style="rounded=1;arcSize=12;fillColor=#f8cecc;strokeColor=#b85450;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1404" y="124" width="172" height="54" as="geometry"/></mxCell><mxCell id="online" value="Online?" style="rhombus;fillColor=#fff2cc;strokeColor=#d6b656;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1404" y="238" width="172" height="84" as="geometry"/></mxCell><mxCell id="off" value="Bez interneta, try later" style="ellipse;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1682" y="124" width="152" height="52" as="geometry"/></mxCell><mxCell id="ins" value="time_requests (pending)&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;push to parents&lt;/font&gt;" style="shape=cylinder3;boundedLbl=1;size=8;fillColor=#d5e8d4;strokeColor=#82b366;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1672" y="544" width="172" height="54" as="geometry"/></mxCell><mxCell id="inbox" value="Zahtjev za vrijeme" style="rounded=1;arcSize=12;fillColor=#ffffff;strokeColor=#1794D2;strokeWidth=2;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1940" y="919" width="172" height="50" as="geometry"/></mxCell><mxCell id="dec" value="Parent?" style="rhombus;fillColor=#fff2cc;strokeColor=#d6b656;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="2208" y="902" width="172" height="84" as="geometry"/></mxCell><mxCell id="appr" value="approved (minutes can be changed)&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;unlock_grants source = time_request&lt;/font&gt;" style="shape=cylinder3;boundedLbl=1;size=8;fillColor=#d5e8d4;strokeColor=#82b366;whiteSpace=wrap;html=1;fontSize=