<mxfile host="Odlikas-diagrams" pages="1"><diagram id="p-k02" name="K02 Autopilot daily plan"><mxGraphModel adaptiveColors="auto"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="K02 · Autopilot daily plan" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=18;fontColor=#222222;fontFamily=Helvetica;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="3548" height="30" as="geometry"/></mxCell><mxCell id="summary" value="Built on the kid phone at midnight (works offline): Učenje + Kviz + Kartice. The parent is informed, not asked." style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=12;fontColor=#222222;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="0" y="30" width="3548" height="34" as="geometry"/></mxCell><mxCell id="lane0" value="Kid app" style="swimlane;horizontal=0;startSize=34;fillColor=#EAF5FB;swimlaneFillColor=#EAF5FB;strokeColor=#BBBBBB;fontStyle=1;fontSize=13;html=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="0" y="70" width="3548" height="317" as="geometry"/></mxCell><mxCell id="lane1" value="Server" style="swimlane;horizontal=0;startSize=34;fillColor=#F1F1F1;swimlaneFillColor=#F1F1F1;strokeColor=#BBBBBB;fontStyle=1;fontSize=13;html=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="0" y="387" width="3548" height="146" as="geometry"/></mxCell><mxCell id="s" value="00:00 Europe/Zagreb&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;or first open of the day&lt;/font&gt;" style="ellipse;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="74" y="148" width="152" height="58" as="geometry"/></mxCell><mxCell id="exists" value="Plan for today exists?" style="rhombus;fillColor=#fff2cc;strokeColor=#d6b656;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="332" y="136" width="172" height="84" as="geometry"/></mxCell><mxCell id="use" value="Use it" style="ellipse;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="610" y="152" width="152" height="52" as="geometry"/></mxCell><mxCell id="close" value="Close yesterday: completed / missed&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;update streak (K16)&lt;/font&gt;" style="rounded=1;arcSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="600" y="272" width="172" height="70" as="geometry"/></mxCell><mxCell id="day" value="Today is?" style="rhombus;fillColor=#fff2cc;strokeColor=#d6b656;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="868" y="136" width="172" height="84" as="geometry"/></mxCell><mxCell id="hol" value="Plan paused&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;(početna vikend / praznici)&lt;/font&gt;" style="ellipse;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1414" y="140" width="152" height="74" as="geometry"/></mxCell><mxCell id="wk" value="'Zadaci i vikendom' on?" style="rhombus;fillColor=#fff2cc;strokeColor=#d6b656;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1136" y="136" width="172" height="84" as="geometry"/></mxCell><mxCell id="freed" value="Slobodan dan: no tasks" style="ellipse;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1146" y="280" width="152" height="52" as="geometry"/></mxCell><mxCell id="test" value="e-Dnevnik test&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;within the next week?&lt;/font&gt;" style="rhombus;fillColor=#fff2cc;strokeColor=#d6b656;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1404" y="256" width="172" height="101" as="geometry"/></mxCell><mxCell id="tsub" value="Quiz = the test's subject" style="rounded=1;arcSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1672" y="150" width="172" height="54" as="geometry"/></mxCell><mxCell id="ktop" value="Quiz = the kid's topic&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;(curriculum; 'Ne znam' → review)&lt;/font&gt;" style="rounded=1;arcSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1672" y="272" width="172" height="70" as="geometry"/></mxCell><mxCell id="cards" value="Mistakes or a 1–2 grade&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;to revisit?&lt;/font&gt;" style="rhombus;fillColor=#fff2cc;strokeColor=#d6b656;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1940" y="127" width="172" height="101" as="geometry"/></mxCell><mxCell id="addc" value="Add Kartice task" style="rounded=1;arcSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="2208" y="152" width="172" height="50" as="geometry"/></mxCell><mxCell id="mk" value="Plan: Učenje + Kviz (+ Kartice)&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;per-task minutes&lt;/font&gt;" style="rounded=1;arcSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="2476" y="142" width="172" height="70" as="geometry"/></mxCell><mxCell id="on" value="Online?" style="rhombus;fillColor=#fff2cc;strokeColor=#d6b656;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="2744" y="136" width="172" height="84" as="geometry"/></mxCell><mxCell id="up" value="Upsert daily_plans, tasks&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;parent informed, no approval&lt;/font&gt;" style="shape=cylinder3;boundedLbl=1;size=8;fillColor=#d5e8d4;strokeColor=#82b366;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="3012" y="417" width="172" height="86" as="geometry"/></mxCell><mxCell id="ok" value="Plan shown on Početna" style="ellipse;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="3290" y="152" width="152" height="52" as="geometry"/></mxCell><mxCell id="q" value="Queue in outbox (B06)" style="ellipse;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="3022" y="152" width="152" height="52" as="geometry"/></mxCell><mxCell id="e0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;endFill=1;strokeColor=#555555;labelBackgroundColor=default;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="s" target="exists"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e1" value="Yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;endFill=1;strokeColor=#555555;labelBackgroundColor=default;fontColor=#2D7600;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="exists" target="use"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e2" value="No" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;endFill=1;strokeColor=#555555;labelBackgroundColor=default;fontColor=#B20000;exitX=0.5;exitY=1;entryX=0;entryY=0.5;" edge="1" parent="1" source="exists" target="close"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounde