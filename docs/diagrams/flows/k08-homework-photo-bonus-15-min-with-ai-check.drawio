<mxfile host="Odlikas-diagrams" pages="1"><diagram id="p-k08" name="K08 Homework photo bonus (+15 min) with AI check"><mxGraphModel adaptiveColors="auto"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="K08 · Homework photo bonus (+15 min) with AI check" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=18;fontColor=#222222;fontFamily=Helvetica;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="3548" height="30" as="geometry"/></mxCell><mxCell id="summary" value="A photo of finished homework gives +15 min, max 2× a day. AI checks it is real, finished homework; mistakes are shown only as help and never block the reward." style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=12;fontColor=#222222;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="0" y="30" width="3548" height="34" as="geometry"/></mxCell><mxCell id="lane0" value="Kid app" style="swimlane;horizontal=0;startSize=34;fillColor=#EAF5FB;swimlaneFillColor=#EAF5FB;strokeColor=#BBBBBB;fontStyle=1;fontSize=13;html=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="0" y="70" width="3548" height="274" as="geometry"/></mxCell><mxCell id="lane1" value="Server" style="swimlane;horizontal=0;startSize=34;fillColor=#F1F1F1;swimlaneFillColor=#F1F1F1;strokeColor=#BBBBBB;fontStyle=1;fontSize=13;html=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="0" y="344" width="3548" height="146" as="geometry"/></mxCell><mxCell id="lane2" value="External" style="swimlane;horizontal=0;startSize=34;fillColor=#FFF8E8;swimlaneFillColor=#FFF8E8;strokeColor=#BBBBBB;fontStyle=1;fontSize=13;html=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="0" y="490" width="3548" height="146" as="geometry"/></mxCell><mxCell id="s" value="Bonus - uslikaj zadaću&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;(Početna or locked app)&lt;/font&gt;" style="ellipse;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="74" y="122" width="152" height="58" as="geometry"/></mxCell><mxCell id="cap" value="Bonus photos today &amp;lt; 2?" style="rhombus;fillColor=#fff2cc;strokeColor=#d6b656;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="332" y="109" width="172" height="84" as="geometry"/></mxCell><mxCell id="capno" value="Danas već 2 bonusa" style="ellipse;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="610" y="125" width="152" height="52" as="geometry"/></mxCell><mxCell id="shot" value="Fotografija zadaće&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;(crop, shrink, no EXIF)&lt;/font&gt;" style="rounded=1;arcSize=12;fillColor=#ffffff;strokeColor=#1794D2;strokeWidth=2;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="600" y="236" width="172" height="54" as="geometry"/></mxCell><mxCell id="send" value="Zadaća skenirana →&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;Pošalji na provjeru&lt;/font&gt;" style="rounded=1;arcSize=12;fillColor=#ffffff;strokeColor=#1794D2;strokeWidth=2;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="868" y="124" width="172" height="54" as="geometry"/></mxCell><mxCell id="up" value="photos/ (deleted after 30 days)" style="shape=cylinder3;boundedLbl=1;size=8;fillColor=#d5e8d4;strokeColor=#82b366;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1136" y="390" width="172" height="54" as="geometry"/></mxCell><mxCell id="ai" value="AI: real, finished homework?&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;mistakes (math re-checked in code)&lt;/font&gt;" style="rounded=1;arcSize=12;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;whiteSpace=wrap;html=1;fon