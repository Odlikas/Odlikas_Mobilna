<mxfile host="Odlikas-diagrams" pages="1"><diagram id="p-k01" name="K01 Kid phone setup and permissions"><mxGraphModel adaptiveColors="auto"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="K01 · Kid phone setup and permissions" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=18;fontColor=#222222;fontFamily=Helvetica;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="2744" height="30" as="geometry"/></mxCell><mxCell id="summary" value="After pairing. The parent sits with the kid; Android uses the Kotlin engine, iOS uses FamilyControls." style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=12;fontColor=#222222;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="0" y="30" width="2744" height="34" as="geometry"/></mxCell><mxCell id="lane0" value="Kid app" style="swimlane;horizontal=0;startSize=34;fillColor=#EAF5FB;swimlaneFillColor=#EAF5FB;strokeColor=#BBBBBB;fontStyle=1;fontSize=13;html=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="0" y="70" width="2744" height="383" as="geometry"/></mxCell><mxCell id="lane1" value="External" style="swimlane;horizontal=0;startSize=34;fillColor=#FFF8E8;swimlaneFillColor=#FFF8E8;strokeColor=#BBBBBB;fontStyle=1;fontSize=13;html=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="0" y="453" width="2744" height="139" as="geometry"/></mxCell><mxCell id="lane2" value="Server" style="swimlane;horizontal=0;startSize=34;fillColor=#F1F1F1;swimlaneFillColor=#F1F1F1;strokeColor=#BBBBBB;fontStyle=1;fontSize=13;html=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="0" y="592" width="2744" height="123" as="geometry"/></mxCell><mxCell id="s" value="Paired (P02) + dogovor&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;accepted (P13)&lt;/font&gt;" style="ellipse;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="74" y="114" width="152" height="58" as="geometry"/></mxCell><mxCell id="plat" value="Platform?" style="rhombus;fillColor=#fff2cc;strokeColor=#d6b656;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="332" y="101" width="172" height="84" as="geometry"/></mxCell><mxCell id="acc" value="Accessibility service" style="rounded=1;arcSize=12;fillColor=#ffffff;strokeColor=#1794D2;strokeWidth=2;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="600" y="118" width="172" height="50" as="geometry"/></mxCell><mxCell id="usage" value="Usage access" style="rounded=1;arcSize=12;fillColor=#ffffff;strokeColor=#1794D2;strokeWidth=2;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="868" y="118" width="172" height="50" as="geometry"/></mxCell><mxCell id="notif" value="Notifications + battery&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;optimisation off&lt;/font&gt;" style="rounded=1;arcSize=12;fillColor=#ffffff;strokeColor=#1794D2;strokeWidth=2;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1136" y="116" width="172" height="54" as="geometry"/></mxCell><mxCell id="allA" value="All granted?" style="rhombus;fillColor=#fff2cc;strokeColor=#d6b656;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1404" y="101" width="172" height="84" as="geometry"/></mxCell><mxCell id="explain" value="Explain why + open Settings" style="rounded=1;arcSize=12;fillColor=#f8cecc;strokeColor=#b85450;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1672" y="116" width="172" height="54" as="geometry"/></mxCell><mxCell id="pickA" value="Apps to lock come from the&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;parent's Odaberi aplikacije&lt;/font&gt;" style="rounded=1;arcSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1672" y="214" width="172" height="86" as="geometry"/></mxCell><mxCell id="fc" value="FamilyControls authorization&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;(parent approves)&lt;/font&gt;" style="rounded=1;arcSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="600" y="483" width="172" height="70" as="geometry"/></mxCell><mxCell id="allI" value="Approved?" style="rhombus;fillColor=#fff2cc;strokeColor=#d6b656;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="868" y="215" width="172" height="84" as="geometry"/></mxCell><mxCell id="askp" value="Ask parent to approve" style="rounded=1;arcSize=12;fillColor=#f8cecc;strokeColor=#b85450;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1136" y="232" width="172" height="50" as="geometry"/></mxCell><mxCell id="pickI" value="FamilyActivityPicker&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;(app tokens stay on device)&lt;/font&gt;" style="rounded=1;arcSize=12;fillColor=#ffffff;strokeColor=#1794D2;strokeWidth=2;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1136" y="336" width="172" height="70" as="geometry"/></mxCell><mxCell id="save" value="devices.permissions,&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;blocking_ok = true&lt;/font&gt;" style="shape=cylinder3;boundedLbl=1;size=8;fillColor=#d5e8d4;strokeColor=#82b366;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1940" y="631" width="172" height="54" as="geometry"/></mxCell><mxCell id="packs" value="Download content packs (K12)" style="rounded=1;arcSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mx