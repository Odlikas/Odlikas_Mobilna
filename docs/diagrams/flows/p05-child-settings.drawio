ent label (mama / tata / …)" style="rounded=1;arcSize=12;fillColor=#ffffff;strokeColor=#1794D2;strokeWidth=2;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="600" y="675" width="172" height="54" as="geometry"/></mxCell><mxCell id="valid" value="Within allowed range?" style="rhombus;fillColor=#fff2cc;strokeColor=#d6b656;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="868" y="100" width="172" height="84" as="geometry"/></mxCell><mxCell id="err" value="Show allowed range" style="rounded=1;arcSize=12;fillColor=#f8cecc;strokeColor=#b85450;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1136" y="117" width="172" height="50" as="geometry"/></mxCell><mxCell id="save" value="Update child_settings (updated_by)&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;+ audit_log&lt;/font&gt;" style="shape=cylinder3;boundedLbl=1;size=8;fillColor=#d5e8d4;strokeColor=#82b366;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1136" y="820" width="172" height="70" as="geometry"/></mxCell><mxCell id="online" value="Kid phone online?" style="rhombus;fillColor=#fff2cc;strokeColor=#d6b656;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1404" y="813" width="172" height="84" as="geometry"/></mxCell><mxCell id="rt" value="Realtime: store settings locally" style="ellipse;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1682" y="957" width="152" height="58" as="geometry"/></mxCell><mxCell id="later" value="Applied on next sync" style="ellipse;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1682" y="1046" width="152" height="52" as="geometry"/></mxCell><mxCell id="e0" 