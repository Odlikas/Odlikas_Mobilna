<mxfile host="Odlikas-diagrams" pages="1"><diagram id="p-b02" name="B02 ai-gateway (every paid AI call)"><mxGraphModel adaptiveColors="auto"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="B02 · ai-gateway (every paid AI call)" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=18;fontColor=#222222;fontFamily=Helvetica;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="3012" height="30" as="geometry"/></mxCell><mxCell id="summary" value="One Edge Function owns every AI call. Cheapest model first, validate with code, escalate once, log the cost." style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=12;fontColor=#222222;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="0" y="30" width="3012" height="34" as="geometry"/></mxCell><mxCell id="lane0" value="Server" style="swimlane;horizontal=0;startSize=34;fillColor=#F1F1F1;swimlaneFillColor=#F1F1F1;strokeColor=#BBBBBB;fontStyle=1;fontSize=13;html=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="0" y="70" width="3012" height="342" as="geometry"/></mxCell><mxCell id="lane1" value="External" style="swimlane;horizontal=0;startSize=34;fillColor=#FFF8E8;swimlaneFillColor=#FFF8E8;strokeColor=#BBBBBB;fontStyle=1;fontSize=13;html=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="0" y="412" width="3012" height="114" as="geometry"/></mxCell><mxCell id="s" value="Called with feature + payload" style="ellipse;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="74" y="139" width="152" height="58" as="geometry"/></mxCell><mxCell id="auth" value="JWT valid, family active?" style="rhombus;fillColor=#fff2cc;strokeColor=#d6b656;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="332" y="126" width="172" height="84" as="geometry"/></mxCell><mxCell id="401" value="401" style="ellipse;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="610" y="142" width="152" height="52" as="geometry"/></mxCell><mxCell id="quota" value="Quota ok? (B03)" style="rhombus;fillColor=#fff2cc;strokeColor=#d6b656;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="600" y="272" width="172" height="84" as="geometry"/></mxCell><mxCell id="429" value="Friendly limit" style="ellipse;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="878" y="142" width="152" height="52" as="geometry"/></mxCell><mxCell id="bud" value="Daily budget left?&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;(app_config kill switch)&lt;/font&gt;" style="rhombus;fillColor=#fff2cc;strokeColor=#d6b656;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="868" y="255" width="172" height="118" as="geometry"/></mxCell><mxCell id="deg" value="Degrade: cache + code only" style="ellipse;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1146" y="139" width="152" height="58" as="geometry"/></mxCell><mxCell id="pre" value="Stable prompt prefix +&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;strict JSON schema, token cap&lt;/font&gt;" style="rounded=1;arcSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1136" y="279" width="172" height="70" as="geometry"/></mxCell><mxCell id="small" value="Small model (Haiku 5.5)" style="rounded=1;arcSize=12;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1404" y="444" width="172" height="50" as="geometry"/></mxCell><mxCell id="val" value="Valid JSON, math re-computes,&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;confidence ok?&lt;/font&gt;" style="rhombus;fillColor=#fff2cc;strokeColor=#d6b656;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1672" y="118" width="172" height="101" as="geometry"/></mxCell><mxCell id="esc" value="Already escalated?" style="rhombus;fillColor=#fff2cc;strokeColor=#d6b656;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1940" y="126" width="172" height="84" as="geometry"/></mxCell><mxCell id="big" value="Bigger model (Sonnet 5.5)" style="rounded=1;arcSize=12;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="2208" y="442" width="172" height="54" as="geometry"/></mxCell><mxCell id="unsure" value="Return 'unsure'&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;→ parent decides&lt;/font&gt;" style="rounded=1;arcSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="2208" y="141" width="172" height="54" as="geometry"/></mxCell><mxCell id="log" value="ai_calls: feature, route, tokens,&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;cost_eur, cache_hit, latency&lt;/font&gt;" style="shape=cylinder3;boundedLbl=1;size=8;fillColor=#d5e8d4;strokeColor=#82b366;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="2476" y="125" width="172" height="86" as="geometry"/></mxCell><mxCell id="ret" value="Return result" style="ellipse;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="2754" y="142" width="152" height="52" as="geometry"/></mxCell><mxCell id="e0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;h