<mxfile host="Odlikas-diagrams" pages="1"><diagram id="p-b07" name="B07 Question bank pipeline (offline, once per content version)"><mxGraphModel adaptiveColors="auto"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="B07 · Question bank pipeline (offline, once per content version)" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=18;fontColor=#222222;fontFamily=Helvetica;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="3012" height="30" as="geometry"/></mxCell><mxCell id="summary" value="Math gets code generators; other subjects get batch AI items that the team reviews before they ship in packs." style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=12;fontColor=#222222;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="0" y="30" width="3012" height="34" as="geometry"/></mxCell><mxCell id="lane0" value="Team" style="swimlane;horizontal=0;startSize=34;fillColor=#F3EEF9;swimlaneFillColor=#F3EEF9;strokeColor=#BBBBBB;fontStyle=1;fontSize=13;html=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="0" y="70" width="3012" height="144" as="geometry"/></mxCell><mxCell id="lane1" value="Server" style="swimlane;horizontal=0;startSize=34;fillColor=#F1F1F1;swimlaneFillColor=#F1F1F1;strokeColor=#BBBBBB;fontStyle=1;fontSize=13;html=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="0" y="214" width="3012" height="367" as="geometry"/></mxCell><mxCell id="lane2" value="External" style="swimlane;horizontal=0;startSize=34;fillColor=#FFF8E8;swimlaneFillColor=#FFF8E8;strokeColor=#BBBBBB;fontStyle=1;fontSize=13;html=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="0" y="581" width="3012" height="139" as="geometry"/></mxCell><mxCell id="s" value="Import NN 7/2019 outcomes&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;(script)&lt;/font&gt;" style="ellipse;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;whiteSpace=wrap;html=1;fontSize=12;fon