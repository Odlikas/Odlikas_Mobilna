ight="20" as="geometry"/></mxCell><mxCell id="note1" value="Legend: green = start/success · blue = step · white = screen · yellow = decision · orange = external / waiting · purple = paid AI or Odlikaš+ · red = error / stop · dashed line = loop back" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;fontColor=#555555;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="0" y="700" width="2476" height="20" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p-p03" name="P03 e-Dnevnik login and sync (parent app)"><mxGraphModel adaptiveColors="auto"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="P03 · e-Dnevnik login and sync (parent app)" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=18;fontColor=#222222;fontFamily=Helvetica;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="5424" height="30" as="geometry"/></mxCell><mxCell id="summary" value="Runs when the parent app opens and once a day in the background. The kid's login lives only in the parent phone's keystore." style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=12;fontColor=#222222;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="0" y="30" width="5424" height="34" as="geometry"/></mxCell><mxCell id="lane0" value="Parent app" style="swimlane;horizontal=0;startSize=34;fillColor=#FDF3E7;swimlaneFillColor=#FDF3E7;strokeColor=#BBBBBB;fontStyle=1;fontSize=13;html=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="0" y="70" width="5424" height="455" as="geometry"/></mxCell><mxCell id="lane1" value="External" style="swimlane;horizontal=0;startSize=34;fillColor=#FFF8E8;swimlaneFillColor=#FFF8E8;strokeColor=#BBBBBB;fontStyle=1;fontSize=13;html=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="0" y="525" width="5424" height="114" as="geometry"/></mxCell><mxCell id="lane2" value="Server" style="swimlane;horizontal=0;startSize=34;fillColor=#F1F1