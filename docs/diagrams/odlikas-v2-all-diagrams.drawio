th="172" height="84" as="geometry"/></mxCell><mxCell id="freed" value="Slobodan dan: no tasks" style="ellipse;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1146" y="280" width="152" height="52" as="geometry"/></mxCell><mxCell id="test" value="e-Dnevnik test&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;within the next week?&lt;/font&gt;" style="rhombus;fillColor=#fff2cc;strokeColor=#d6b656;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1404" y="256" width="172" height="101" as="geometry"/></mxCell><mxCell id="tsub" value="Quiz = the test's subject" style="rounded=1;arcSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1672" y="150" width="172" height="54" as="geometry"/></mxCell><mxCell id="ktop" value="Quiz = the kid's topic&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;(curriculum; 'Ne znam' → review)&lt;/font&gt;" style="rounded=1;arcSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1672" y="272" width="172" height="70" as="geometry"/></mxCell><mxCell id="cards" value="Mistakes or a 1–2 grade&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;to revisit?&lt;/font&gt;" style="rhombus;fillColor=#fff2cc;strokeColor=#d6b656;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1940" y="127" width="172" height="101" as="geometry"/></mxCell><mxCell id="addc" value="Add Kartice task" style="rounded=1;arcSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="2208" y="152" width="172" height="50" as="geometry"/></mxCell><mxCell id="mk" value="Plan: Učenje + Kviz (+ Kartice)&lt;br&gt;&lt;