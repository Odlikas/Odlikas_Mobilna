+ pgmq)" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=18;fontColor=#222222;fontFamily=Helvetica;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1136" height="30" as="geometry"/></mxCell><mxCell id="summary" value="Retention, reports and budget control run inside Postgres; no extra service." style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=12;fontColor=#222222;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="0" y="30" width="1136" height="34" as="geometry"/></mxCell><mxCell id="lane0" value="Server" style="swimlane;horizontal=0;startSize=34;fillColor=#F1F1F1;swimlaneFillColor=#F1F1F1;strokeColor=#BBBBBB;fontStyle=1;fontSize=13;html=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="0" y="70" width="1136" height="1322" as="geometry"/></mxCell><mxCell id="lane1" value="Parent app" style="swimlane;horizontal=0;startSize=34;fillColor=#FDF3E7;swimlaneFillColor=#FDF3E7;strokeColor=#BBBBBB;fontStyle=1;fontSize=13;html=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="0" y="1392" width="1136" height="118" as="geometry"/></mxCell><mxCell id="s" value="pg_cron fires" style="ellipse;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="74" y="124" width="152" height="52" as="geometry"/></mxCell><mxCell id="job" value="Which job?" style="rhombus;fillColor=#fff2cc;strokeColor=#d6b656;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="332" y="108" width="172" height="84" as="geometry"/></mxCell><mxCell id="ph" value="02:00 daily: photos past delete_after&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;delete file + ocr_text&lt;/font&gt;" style="ellipse;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="610" y="114" width="152" height="74" as="geometry"/></mxCell><mxCell id="tr" value="00:00 daily: pending time_requests&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;→ expired&lt;/font&gt;" style="ellipse;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="610" y="242" width="152" height="74" as="geometry"/></mxCell><mxCell id="wr" value="Sunday 22:00: weekly_reports&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;(SQL aggregates)&lt;/font&gt;" style="shape=cylinder3;boundedLbl=1;size=8;fillColor=#d5e8d4;strokeColor=#82b366;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="600" y="374" width="172" height="70" as="geometry"/></mxCell><mxCell id="wrn" value="Weekly report notification" style="ellipse;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="878" y="1422" width="152" height="58" as="geometry"/></mxCell><mxCell id="fam" value="Daily: families deleted 30+ days ago&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;hard delete&lt;/font&gt;" style="ellipse;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="610" y="500" width="152" height="74" as="geometry"/></mxCell><mxCell id="dev" value="Daily: devices silent 48 h → P11" style="ellipse;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="610" y="638" width="152" height="58" as="geometry"/></mxCell><mxCell id="bud" value="Hourly: AI spend vs daily budget" style="rhombus;fillColor=#fff2cc;strokeColor=#d6b656;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="600" y="745" width="172" height="101" as="geometry"/></mxCell><mxCell id="mail" value="≥ 80%