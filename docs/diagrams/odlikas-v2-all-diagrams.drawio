eSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1940" y="259" width="172" height="54" as="geometry"/></mxCell><mxCell id="all" value="All 5 correct?" style="rhombus;fillColor=#fff2cc;strokeColor=#d6b656;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1940" y="356" width="172" height="84" as="geometry"/></mxCell><mxCell id="done" value="Task done → K03" style="ellipse;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="2218" y="260" width="152" height="52" as="geometry"/></mxCell><mxCell id="e0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;endFill=1;strokeColor=#555555;labelBackgroundColor=default;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="s" target="fol"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e1" value="No" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;endFill=1;strokeColor=#555555;labelBackgroundColor=default;fontColor=#B20000;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="fol" target="none"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e2" value="Yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;endFill=1;strokeColor=#555555;labelBackgroundColor=default;fontColor=#2D7600;exitX=0.5;exitY=1;entryX=0;entryY=0.5;" edge="1" parent="1" source="fol" target="task"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;endFill=1;strokeColor=#555555;labelBackgroundColor=default;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="task" target="cards"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e4" value="" style="edgeSty