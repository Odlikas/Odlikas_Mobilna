"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e19" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;endFill=1;strokeColor=#555555;labelBackgroundColor=default;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="up" target="ok"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e20" value="No" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;endFill=1;strokeColor=#555555;labelBackgroundColor=default;fontColor=#B20000;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="on" target="q"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="note0" value="The parent can still remove or swap a task (long-press), add their own, or unlock by hand (P04)." style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;fontColor=#555555;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="0" y="549" width="3548" height="20" as="geometry"/></mxCell><mxCell id="note1" value="Legend: green = start/success · blue = step · white = screen · yellow = decision · orange = external / waiting · purple = paid AI or Odlikaš+ · red = error / stop · dashed line = loop back" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;fontColor=#555555;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="0" y="571" width="3548" height="20" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p-k03" name="K03 Lock and unlock engine"><mxGraphModel adaptiveColors="auto"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="K03 · Lock and unlock engine" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=18;fontColor=#222222;fontFamily=Helvetica;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1940" height="30" as="geometry"/></mxCell><mxCell id="summary" value="Every task earns minutes ('Svaki zadatak ti donosi minute'), finishing all of them gives +60 (copy to confirm). Extra grants: homework photo, streak and goal rewards, time requests, parent's manual unlock. Never AI." style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=12;fontColor=#222222;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="0" y="30" width="1940" height="34" as="geometry"/></mxCell><mxCell id="lane0" value="Kid app" style="swimlane;horizontal=0;startSize=34;fillColor=#EAF5FB;swimlaneFillColor=#EAF5FB;strokeColor=#BBBBBB;fontStyle=1;fontSize=13;html=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="0" y="70" width="1940" height="461" as="geometry"/></mxCell><mxCell id="lane1" value="Server" style="swimlane;horizontal=0;startSize=34;fillColor=#F1F1F1;swimlaneFillColor=#F1F1F1;strokeColor=#BBBBBB;fontStyle=1;fontSize=13;html=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="0" y="531" width="1940" height="114" as="geometry"/></mxCell><mxCell id="lane2" value="Parent app" style="swimlane;horizontal=0;startSize=34;fillColor=#FDF3E7;swimlaneFillColor=#FDF3E7;strokeColor=#BBBBBB;fontStyle=1;fontSize=13;html=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="0" y="645" width="1940" height="112" as="geometry"/></mxCell><mxCell id="s" value="A task becomes done" style="ellipse;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="74" y="154" width="152" height="52" as="geometry"/></mxCell><mxCell id="per" value="+ that task's minutes" style="rounded=1;arcSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="332" y="155" width="172" height="50" as="geometry"/></mxCell><mxCell id="all" value="All of today's tasks done?" style="rhombus;fillColor=#fff2cc;strokeColor=#d6b656;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometr