metry"></mxGeometry></mxCell><mxCell id="e10" value="No, next card" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;endFill=1;strokeColor=#555555;labelBackgroundColor=default;fontColor=#B20000;exitX=1;exitY=0.5;entryX=0;entryY=0.5;dashed=1;" edge="1" parent="1" source="all" target="show"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="2135" y="398"/><mxPoint x="2135" y="471"/><mxPoint x="1113" y="471"/><mxPoint x="1113" y="286"/></Array></mxGeometry></mxCell><mxCell id="e11" value="Yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;endFill=1;strokeColor=#555555;labelBackgroundColor=default;fontColor=#2D7600;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="all" target="done"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="note0" value="Legend: green = start/success · blue = step · white = screen · yellow = decision · orange = external / waiting · purple = paid AI or Odlikaš+ · red = error / stop · dashed line = loop back" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;fontColor=#555555;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="0" y="504" width="2476" height="20" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p-k06" name="K06 Učenje (focus rounds and breaks)"><mxGraphModel adaptiveColors="auto"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="K06 · Učenje (focus rounds and breaks)" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=18;fontColor=#222222;fontFamily=Helvetica;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="3012" height="30" as="geometry"/></mxCell><mxCell id="summary" value="Defaults by grade: 1–2 15/5, 3–4 20/5, 5–8 25/5 min. After 4 rounds a 15 min long break. Skipping focus needs a confirm and the round doesn't count; skipping a break is fine; a pause over 10 min resets the round." style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=12;fontColor=#222222;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="0" y="30" width="3012" height="34" as="geometry"/></mxCell><mxCell id="lane0" value="Kid app" style="swimlane;horizontal=0;startSize=34;fillColor=#EAF5FB;swimlaneFillColor=#EAF5FB;strokeColor=#BBBBBB;fontStyle=1;fontSize=13;html=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="0" y="70" width="3012" height="646" as="geometry"/></mxCell><mxCell id="lane1" value="Server" style="swimlane;horizontal=0;startSize=34;fillColor=#F1F1F1;swimlaneFillColor=#F1F1F1;strokeColor=#BBBBBB;fontStyle=1;fontSize=13;html=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="0" y="716" width="3012" height="114" as="geometry"/></mxCell><mxCell id="s" value="Kid: Učenje tab or task" style="ellipse;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="74" y="116" width="152" height="52" as="geometry"/></mxCell><mxCell id="setup" value="Učenje odabir&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;(6 offline sounds, ? kako radi)&lt;/font&gt;" style="rounded=1;arcSize=12;fillColor=#ffffff;strokeColor=#1794D2;strokeWidth=2;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="332" y="107" width="172" height="70" as="geometry"/></mxCell><mxCell id="focus" value="Focus timer" style="rounded=1;arcSize=12;fillColor=#ffffff;strokeColor=#1794D2;strokeWidth=2;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="600" y="117" width="172" height="50" as="geometry"/></mxCell><mxCell id="ev" value="What happens?" style="rhombus;fillColor=#fff2cc;strokeColor=#d6b656;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="868" y="100" width="172" height="84" as="geometry"/></mxCell><mxCell id="skipc" value="P