      <mxCell id="title" value="C03 · Area C · Curriculum and content (global)" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=18;fontColor=#222222;fontFamily=Helvetica;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="12" y="-78" width="1653" height="30" as="geometry" /></mxCell><mxCell id="summary" value="Shared by every family, no personal data. Math is served by generators; other subjects by approved bank items in packs." style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=12;fontColor=#222222;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="12" y="-48" width="1653" height="40" as="geometry" /></mxCell><mxCell id="legend" value="Legend: blue = family table (RLS on family_id) · green = global content, no personal data · grey = table from another area · purple = Dart · orange = Edge Function (TypeScript) · yellow = native (Kotlin / Swift) · red = enum. Arrow = foreign key / uses; ◆ = owns." style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;fontColor=#555555;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="12" y="1122" width="1653" height="34" as="geometry" /></mxCell></root>
