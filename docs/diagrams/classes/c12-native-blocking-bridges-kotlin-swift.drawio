      <mxCell id="title" value="C12 · Native blocking bridges (Kotlin · Swift)" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=18;fontColor=#222222;fontFamily=Helvetica;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="12" y="-78" width="1112" height="30" as="geometry" /></mxCell><mxCell id="summary" value="Flutter writes the unlock state; the native side enforces it. Server stores minutes only, never app names. Plan 6." style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=12;fontColor=#222222;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="12" y="-48" width="1112" height="40" as="geometry" /></mxCell><mxCell id="legend" value="Legend: blue = family table (RLS on family_id) · green = global content, no personal data · grey = table from another area · purple = Dart · orange = Edge Function (TypeScript) · yellow = native (Kotlin / Swift) · red = enum. Arrow = foreign key / uses; ◆ = owns." style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;fontColor=#555555;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="12" y="950" width="1112" height="34" as="geometry" /></mxCell></root>
